  ∀ (h : HarappaSign) (p : RiemannProblem),
  h.id = 65 →
  encodes h p →
  h.date < discovery_date p := by
  intros h p hid henc
  have h1 : h.date < -1900 := by
    apply harappa_period_upper
    exact hid
  have h2 : discovery_date p > 1800 := by
    apply modern_discovery
  omega

theorem verify_Riemann_037_encoding :
  ∀ (aspect : RiemannAspect),
  aspect.id = 37 →
  ∃ (h : HarappaSign),
    encodes_aspect h aspect := by
  intro aspect hid
  existsi harappa_sign_213
  apply aspect_encoding_riemann
  exact hid

