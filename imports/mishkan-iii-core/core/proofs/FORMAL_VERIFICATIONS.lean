/-- Teorema de Integração 1 -/

theorem integration_0001 :
  ∀ (h : HarappaSystem) (m : ModernSystem),
  equivalent h m →
  preserves_semantics (translate h m) := by
  intros h m h_equiv
  unfold preserves_semantics
  intro formula
  apply semantic_preservation
  exact h_equiv

theorem integration_0001_bijection :
  ∀ (f : HarappaFormula → ModernFormula),
  translation_function f →
  bijective f := by
  intro f h_trans
  constructor
  · apply injective_translation
    exact h_trans
  · apply surjective_translation
    exact h_trans

theorem integration_0001_isomorphism :
  ∀ (h : HarappaStructure) (m : ModernStructure),
  isomorphic h m →
  equivalent_theories h m := by
  intros h m h_iso
  apply theory_equivalence
  exact h_iso

