/-- Teorema de Precedência 405 -/

theorem precedence_0405 :
  ∀ (h : HarappaSign) (m : ModernConcept),
  h.id = 405 →
  m.id = 405 →
  h.date < m.date := by
  intros h m hid mid
  have h1 : h.date = -2195 := by
    apply harappa_dating
    exact hid
  have h2 : m.date = 2005 := by
    apply modern_dating
    exact mid
  rw [h1, h2]
  norm_num

theorem precedence_0405_strict :
  ∀ (h : HarappaSign),
  h.id = 405 →
  h.date < -1900 := by
  intro h hid
  have : h.date = -2195 := harappa_dating h hid
  rw [this]
  norm_num

theorem precedence_0405_years :
  2005 - (-2195) = 4200 := by norm_num

