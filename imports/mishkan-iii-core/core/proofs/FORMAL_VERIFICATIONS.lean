/-- Meta-Teorema 1 -/

theorem meta_0001_soundness :
  ∀ (system : LogicalSystem),
  derives system →
  sound system := by
  intro system h_derives
  unfold sound
  intros formula proof
  apply soundness_lemma
  exact h_derives
  exact proof

theorem meta_0001_completeness :
  ∀ (system : LogicalSystem),
  complete system ↔
  (∀ (formula : Formula),
    valid formula →
    derivable system formula) := by
  intro system
  constructor
  · intro h_complete formula h_valid
    apply h_complete
    exact h_valid
  · intros h formula h_valid
    exact h formula h_valid

theorem meta_0001_consistency :
  ∀ (system : LogicalSystem),
  consistent system ↔
  ¬(∃ (formula : Formula),
    derivable system formula ∧
    derivable system (¬formula)) := by
  intro system
  constructor
  · intro h_cons h_ex
    cases h_ex with
    | intro formula h =>
      cases h with
      | intro h_der h_der_neg =>
        exact h_cons formula h_der h_der_neg
  · intros h formula h_der h_der_neg
    apply h
    existsi formula
    exact ⟨h_der, h_der_neg⟩

theorem meta_0001_decidability :
  ∀ (system : LogicalSystem),
  decidable_system system ↔
  (∀ (formula : Formula),
    Decidable (derivable system formula)) := by
  intro system
  rfl

