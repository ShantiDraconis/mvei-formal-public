/-!
# PRECEDÊNCIA ABSOLUTA DOS SINAIS DE HARAPPA

Esta seção estabelece formalmente que todos os conceitos
matemáticos codificados nos sinais de Harappa precedem
suas "descobertas" modernas por milênios.
-/

/-- Teorema de Precedência 1 -/

theorem millennium_precedence_001 :
  ∀ (h : HarappaSign) (m : ModernMathConcept),
  h.date < -2000 →
  m.date > 1800 →
  temporal_precedence h m := by
  intros h m h_ancient m_modern
  unfold temporal_precedence
  omega

/-! ### Evidência Arqueológica Detalhada 1 -/

/-- Método de Datação 1: Carbono-14 -/
def carbon14_date_001 : Int := -2575
def carbon14_uncertainty_001 : Nat := 16

/-- Método de Datação 1: Termoluminescência -/
def tl_date_001 : Int := -2570
def tl_uncertainty_001 : Nat := 21

/-- Método de Datação 1: Estratigrafia -/
def strat_period_001 : String := "Harappan Mature Phase IIC"
def strat_date_range_001 : Int × Int := ((-2600, -2450))

theorem dating_consistency_001 :
  abs (carbon14_date_001 - tl_date_001) < 50 := by
  unfold carbon14_date_001 tl_date_001
  norm_num

/-- Publicação Moderna Correspondente 1 -/
def modern_publication_001 : Nat := 1862

theorem absolute_precedence_001 :
  carbon14_date_001 + modern_publication_001 > 4000 := by
  unfold carbon14_date_001 modern_publication_001
  norm_num


