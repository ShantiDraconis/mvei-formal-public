import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Finset.Basic
import Mathlib.Data.Option.Basic

/-!
# The Indeterminate Framework (TIF) – Core Skeleton v1

This file defines the foundational objects of the Indeterminate Framework (TIF):

- Indeterminate classes and origin tags.
- Expression syntax with variables, constants, indeterminates,
  binary operators, and unary differential/integral operators.
- States (equations + constraints) and entailment.
- Valuations for variables and indeterminates (split as (v, η)).
- Evaluation of expressions under a valuation.
- Admissibility, semantic value set, and collapse.
- Collapse operator (Definition D, aligned with axioms A7/A8).
- Classification predicates.
- Basic lemmas and an example.

## Scope

This file defines the scalar fragment of `T_I`. Extensions to structured domains
(e.g., tuples, functions, distributions) are deferred to future work.

## Note on I and I₀

The base indeterminate constant `I` is identified with the class symbol `I₀`
(i.e., `baseI` below, with `id = 0` and origin `zeroOverZero`).
These two names refer to the same object throughout this document.
-/

-- ─────────────────────────────────────────────────────────────────────────────
-- 1. Indeterminate Classes and Origin Tags
-- ─────────────────────────────────────────────────────────────────────────────

/-- An origin tag recording the semantic provenance of an indeterminate symbol. -/
inductive OriginTag where
  | zeroOverZero   -- 0/0  (basis for the class I = I₀)
  | infMinusInf    -- ∞ - ∞
  | oscillatory    -- e.g., sin(∞)
  | constrained    -- generated by state constraints
  | derived        -- produced by differentiation of an indeterminate
  | integrated     -- produced by integration of an indeterminate
  deriving Repr, BEq, Inhabited, DecidableEq

/-- An indeterminate class `I_k`, identified by a unique natural number and
    an origin tag recording why it was introduced. -/
structure IndetClass where
  id     : Nat
  origin : OriginTag
  deriving Repr, BEq, DecidableEq

/--
`baseI` is the base indeterminate constant `I`, also written `I₀`.

**Note:** `I` and `I₀` are the same object — `baseI` with `id = 0` and
origin `zeroOverZero`. All axioms referring to either name refer to this
single constant.
-/
def baseI : IndetClass := ⟨0, OriginTag.zeroOverZero⟩

-- ─────────────────────────────────────────────────────────────────────────────
-- 2. Expression Syntax
-- ─────────────────────────────────────────────────────────────────────────────

/-- Variables are represented as strings. -/
abbrev Var := String

/--
Expression syntax for `T_I` over a coefficient type `α` (typically `ℂ`).

Includes variables, classical constants, indeterminate symbols, the four
arithmetic operators, and the analysis constructors `deriv` and `integ`.

This covers the *scalar fragment* of `T_I`. Extensions to tuples, functions,
and distributions are deferred.
-/
inductive Expr (α : Type) where
  | var   : Var → Expr α
  | const : α → Expr α
  | indet : IndetClass → Expr α
  | add   : Expr α → Expr α → Expr α
  | sub   : Expr α → Expr α → Expr α
  | mul   : Expr α → Expr α → Expr α
  /-- Division `e₁ ÷_I e₂`. Under **A2**, if a state `Σ` entails
      `Σ ⊨ (t₁ = 0 ∧ t₂ = 0)`, this term rewrites to `baseI` tagged
      with origin `zeroOverZero`. -/
  | div   : Expr α → Expr α → Expr α
  /-- Derivative of `e` with respect to variable `x`. -/
  | deriv : Var → Expr α → Expr α
  /-- Indefinite integral of `e` with respect to variable `x` (placeholder). -/
  | integ : Var → Expr α → Expr α
  deriving Repr, Inhabited

-- ─────────────────────────────────────────────────────────────────────────────
-- 3. States, Constraints, and Entailment
-- ─────────────────────────────────────────────────────────────────────────────

/-- An atomic constraint on expressions, represented as a string predicate.
    In a full formalisation this would be a proper first-order formula. -/
abbrev Constraint := String

/--
A **state** `Σ` records the equations and constraints currently in force.

Equations are pairs of expressions required to evaluate equally under every
admissible valuation. Constraints are additional conditions (e.g., `x > 0`).
-/
structure State (α : Type) where
  equations   : List (Expr α × Expr α)
  constraints : List Constraint
  deriving Repr

/--
**Axiom A2 (Origin marking for zero-over-zero configurations)**

There exists a rewrite rule schema such that for any terms `t₁ t₂`,
if a state `Σ` entails `(t₁ = 0 ∧ t₂ = 0)`, then the term
`t₁ ÷_I t₂` rewrites to the indeterminate class `I₀` tagged with
origin `zeroOverZero`.

In Lean this is expressed as a propositional statement over `State`:
for any valuation-level proof that both numerator and denominator are forced
to zero, the division expression is identified with `baseI`.
-/
def stateEntailsZeroZero {α : Type} [Field α] [DecidableEq α]
    (Σ : State α) (t₁ t₂ : Expr α) : Prop :=
  ∀ v : α → α, ∀ η : IndetClass → Option α,
    -- every admissible valuation forces t₁ and t₂ to evaluate to 0
    True  -- placeholder: full entailment requires a proper logic layer

-- ─────────────────────────────────────────────────────────────────────────────
-- 4. Valuations
-- ─────────────────────────────────────────────────────────────────────────────

/-- Variable valuation `v`: maps each variable to a classical value in `α`. -/
def VarValuation (α : Type) := Var → α

/-- Indeterminate valuation `η`: maps each indeterminate class to an optional
    classical value (present when the indeterminate has been uniquely resolved). -/
def IndetValuation (α : Type) := IndetClass → Option α

/-- A full valuation is a pair `(v, η)` of a variable valuation and an
    indeterminate valuation, reflecting the split introduced in the semantic
    specification. -/
structure Valuation (α : Type) where
  /-- Variable valuation component `v`. -/
  varVal   : VarValuation α
  /-- Indeterminate valuation component `η`. -/
  indetVal : IndetValuation α

-- ─────────────────────────────────────────────────────────────────────────────
-- 5. Evaluation of Expressions
-- ─────────────────────────────────────────────────────────────────────────────

/--
`eval v e` evaluates expression `e` under valuation `v = (varVal, indetVal)`.

Returns `none` when:
- a subexpression contains an indeterminate with no assigned value in `η`;
- division by zero is encountered in the classical case.

For `deriv` and `integ`, a placeholder `none` is returned; these require the
analysis bridge (deferred to the Semantic Specification document).
-/
def eval {α : Type} [Field α] [DecidableEq α] (v : Valuation α) : Expr α → Option α
  | Expr.var x        => some (v.varVal x)
  | Expr.const c      => some c
  | Expr.indet ic     => v.indetVal ic
  | Expr.add e₁ e₂   => do
      let a ← eval v e₁
      let b ← eval v e₂
      return a + b
  | Expr.sub e₁ e₂   => do
      let a ← eval v e₁
      let b ← eval v e₂
      return a - b
  | Expr.mul e₁ e₂   => do
      let a ← eval v e₁
      let b ← eval v e₂
      return a * b
  | Expr.div e₁ e₂   => do
      let a ← eval v e₁
      let b ← eval v e₂
      if b = 0 then none else return a / b
  | Expr.deriv _ _    =>
      -- Placeholder: derivative evaluation requires the analysis bridge.
      -- A full treatment uses Mathlib's `HasDerivAt` or a symbolic differentiator.
      none
  | Expr.integ _ _    =>
      -- Placeholder: integral evaluation is deferred to the analysis bridge.
      none

-- ─────────────────────────────────────────────────────────────────────────────
-- 6. Admissibility and Semantic Value Set
-- ─────────────────────────────────────────────────────────────────────────────

/--
A valuation `val` is **admissible** for state `Σ` if it satisfies every
equation in `Σ.equations` (i.e., the two sides evaluate to the same classical
value under `val`).

Constraint satisfaction is abstracted to `True` here; a full formalisation
would replace this with a proper constraint logic.
-/
def admissible {α : Type} [Field α] [DecidableEq α]
    (val : Valuation α) (Σ : State α) : Prop :=
  (∀ eq ∈ Σ.equations,
     match eval val eq.1, eval val eq.2 with
     | some a, some b => a = b
     | _, _ => False) ∧
  True -- constraint satisfaction (deferred)

/--
The **semantic value set** `⟦e⟧_Σ ⊆ ℂ` is the set of all classical values
that `e` can take under some admissible valuation of `Σ`.

`⟦e⟧_Σ = { c | ∃ val admissible for Σ, eval val e = some c }`
-/
def semanticValueSet {α : Type} [Field α] [DecidableEq α]
    (e : Expr α) (Σ : State α) : Set α :=
  { c | ∃ val : Valuation α, admissible val Σ ∧ eval val e = some c }

-- ─────────────────────────────────────────────────────────────────────────────
-- 7. Collapse Operator (Definition D)
-- ─────────────────────────────────────────────────────────────────────────────

/-!
## Definition D — Collapse Operator (formal)

```
Collapse_Σ : Expr_I → ℂ ∪ {⊥}
```

defined by:

```
Collapse_Σ(e) =
  v   if ⟦e⟧_Σ = {v}   (singleton semantic value set)
  ⊥   otherwise
```

This definition is deliberately aligned with axioms A7 and A8:
- **A7** (soundness): if `Collapse_Σ(e) = v` then every admissible valuation
  assigns `v` to `e`.
- **A8** (completeness): if every admissible valuation assigns the same `v`
  to `e`, then `Collapse_Σ(e) = v`.
-/

/--
`collapseSem e Σ` implements Definition D.

Returns `some v` when `⟦e⟧_Σ` is exactly the singleton `{v}`, and `none`
(representing `⊥`) otherwise.

`none` covers:
- expressions with no admissible evaluation (blocked forms);
- expressions with multiple possible evaluations (genuinely indeterminate);
- expressions involving unresolved indeterminate classes.
-/
noncomputable def collapseSem {α : Type} [Field α] [DecidableEq α]
    (e : Expr α) (Σ : State α) : Option α :=
  let S := semanticValueSet e Σ
  -- Return the unique element if S is a singleton; ⊥ (none) otherwise.
  if h : ∃! v, v ∈ S then some (h.choose) else none

/--
Operational collapse — currently identical to `collapseSem`.

In a rewriting-based implementation this could be refined to return a
structured `Blocked` marker instead of `none`, but for this core skeleton
both notions coincide.
-/
noncomputable def collapseOp {α : Type} [Field α] [DecidableEq α]
    (e : Expr α) (Σ : State α) : Option α :=
  collapseSem e Σ

-- ─────────────────────────────────────────────────────────────────────────────
-- 8. Classification Predicates
-- ─────────────────────────────────────────────────────────────────────────────

/-- An expression is **classical** if it contains no indeterminate subterms and
    no unevaluatable analysis operators (`deriv`/`integ`).

    `deriv` and `integ` are excluded because `eval` returns `none` for them
    in this skeleton — they require the analysis bridge to produce a value. -/
def isClassical {α : Type} : Expr α → Bool
  | Expr.var _        => true
  | Expr.const _      => true
  | Expr.indet _      => false
  | Expr.add e₁ e₂   => isClassical e₁ && isClassical e₂
  | Expr.sub e₁ e₂   => isClassical e₁ && isClassical e₂
  | Expr.mul e₁ e₂   => isClassical e₁ && isClassical e₂
  | Expr.div e₁ e₂   => isClassical e₁ && isClassical e₂
  | Expr.deriv _ _    => false   -- requires analysis bridge; not evaluatable yet
  | Expr.integ _ _    => false   -- requires analysis bridge; not evaluatable yet

/-- An expression is **indeterminate** if it contains at least one `indet` subterm. -/
def isIndeterminate {α : Type} (e : Expr α) : Bool := !isClassical e

/-- An expression is **blocked** under `Σ` if its collapse is `⊥` (i.e., `none`). -/
noncomputable def isBlocked {α : Type} [Field α] [DecidableEq α]
    (e : Expr α) (Σ : State α) : Prop :=
  collapseSem e Σ = none

-- ─────────────────────────────────────────────────────────────────────────────
-- 9. Axiom A11 — Local Non-Identification
-- ─────────────────────────────────────────────────────────────────────────────

/-!
## Axiom A11 — Local Non-Identification

No classical term `t` satisfies `T_I ⊢ t = I` unless it arises as the
collapse of an expression whose semantic value set is uniquely resolved under
a state.

Formally: for all classical expressions `t` and states `Σ`,
```
T_I ⊢ t = I   →   ∃ e, collapseSem e Σ = some (···)  (unique resolution)
```

In Lean, we state the contrapositive: if an expression `e` containing `I`
is not uniquely collapsed under `Σ`, then no classical term is provably
equal to `I` via that expression.
-/

/-- **A11**: if `e` is indeterminate and `collapseSem e Σ = none`, then
    `e` does not reduce to any classical constant under `Σ`.

    This ties A11 directly to the Collapse operator (Definition D). -/
theorem a11_local_non_identification {α : Type} [Field α] [DecidableEq α]
    (e : Expr α) (Σ : State α)
    (hInd : isIndeterminate e = true)
    (hBlocked : isBlocked e Σ) :
    ∀ c : α, collapseSem e Σ ≠ some c := by
  intro c
  exact fun h => absurd h hBlocked

-- ─────────────────────────────────────────────────────────────────────────────
-- 10. Basic Lemmas
-- ─────────────────────────────────────────────────────────────────────────────

/-- A classical expression evaluates to a definite value under any valuation.

    Note: `deriv` and `integ` are not classical in this skeleton (`isClassical`
    returns `false` for them), so those cases are vacuous. -/
lemma classical_eval_some {α : Type} [Field α] [DecidableEq α]
    (e : Expr α) (val : Valuation α)
    (h : isClassical e = true) :
    ∃ c, eval val e = some c := by
  induction e with
  | var x          => exact ⟨_, rfl⟩
  | const c        => exact ⟨_, rfl⟩
  | indet _        => simp [isClassical] at h
  | add e₁ e₂ ih₁ ih₂ =>
      simp [isClassical, Bool.and_eq_true] at h
      obtain ⟨c₁, hc₁⟩ := ih₁ h.1
      obtain ⟨c₂, hc₂⟩ := ih₂ h.2
      exact ⟨c₁ + c₂, by simp [eval, hc₁, hc₂]⟩
  | sub e₁ e₂ ih₁ ih₂ =>
      simp [isClassical, Bool.and_eq_true] at h
      obtain ⟨c₁, hc₁⟩ := ih₁ h.1
      obtain ⟨c₂, hc₂⟩ := ih₂ h.2
      exact ⟨c₁ - c₂, by simp [eval, hc₁, hc₂]⟩
  | mul e₁ e₂ ih₁ ih₂ =>
      simp [isClassical, Bool.and_eq_true] at h
      obtain ⟨c₁, hc₁⟩ := ih₁ h.1
      obtain ⟨c₂, hc₂⟩ := ih₂ h.2
      exact ⟨c₁ * c₂, by simp [eval, hc₁, hc₂]⟩
  | div e₁ e₂ ih₁ ih₂ =>
      simp [isClassical, Bool.and_eq_true] at h
      obtain ⟨c₁, hc₁⟩ := ih₁ h.1
      obtain ⟨c₂, hc₂⟩ := ih₂ h.2
      simp [eval, hc₁, hc₂]
      by_cases hz : c₂ = 0
      · exact ⟨0, by simp [hz]⟩
      · exact ⟨c₁ / c₂, by simp [hz]⟩
  | deriv _ _ _ => simp [isClassical] at h   -- vacuous: isClassical (deriv ..) = false
  | integ _ _ _ => simp [isClassical] at h   -- vacuous: isClassical (integ ..) = false

-- ─────────────────────────────────────────────────────────────────────────────
-- 11. Example: Expression with a Base Indeterminate
-- ─────────────────────────────────────────────────────────────────────────────

/-- Example expression: `I + x` where `I = baseI = I₀`. -/
def exampleExpr : Expr ℂ :=
  Expr.add (Expr.indet baseI) (Expr.var "x")

/-- A state that forces `I = 0` via the equation `indet baseI = const 0`. -/
def exampleState : State ℂ :=
  { equations   := [(Expr.indet baseI, Expr.const 0)]
  , constraints := [] }

/-- A valuation that assigns `0` to `I₀` and `1` to `"x"`. -/
def exampleValuation : Valuation ℂ :=
  { varVal   := fun x => if x = "x" then 1 else 0
  , indetVal := fun ic => if ic == baseI then some 0 else none }

/-- Under `exampleValuation`, `I + x` evaluates to `0 + 1 = 1`. -/
example : eval exampleValuation exampleExpr = some 1 := by
  simp [eval, exampleValuation, exampleExpr, baseI, BEq.beq, IndetClass.beq]

/--
Example: the derivative expression `deriv "x" (I + x)`.

Under a state that assigns `I = 0`, the expected collapse is `some 1`.
The derivative evaluation currently returns `none` because the analysis
bridge (symbolic differentiation via Mathlib) is deferred to the next phase.
-/
def exampleDerivExpr : Expr ℂ :=
  Expr.deriv "x" exampleExpr

#check @collapseSem ℂ _ _ exampleDerivExpr exampleState
-- collapseSem exampleDerivExpr exampleState : Option ℂ
-- Currently evaluates to none; full analysis bridge is the next milestone.
