import Mathlib.MeasureTheory.MeasurableSpace.Basic
import Mathlib.MeasureTheory.MeasurableSpace.Defs

namespace SigmaAlgebras

open Set MeasureTheory

/-! ## 1. Basic Definitions -/

/-- A σ-algebra on a set is a collection closed under complements and countable unions. -/
structure SigmaAlgebra' (Ω : Type*) where
  measurableSets : Set (Set Ω)
  univ_mem : Set.univ ∈ measurableSets
  compl_mem : ∀ S ∈ measurableSets, Sᶜ ∈ measurableSets
  countable_union : ∀ f : ℕ → Set Ω, (∀ n, f n ∈ measurableSets) →
    (⋃ n, f n) ∈ measurableSets

/-- The empty set is measurable. -/
theorem empty_measurable (Σ : SigmaAlgebra' Ω) : ∅ ∈ Σ.measurableSets := by
  have := Σ.compl_mem Set.univ Σ.univ_mem
  simp at this
  exact this

/-- Countable intersections are measurable. -/
theorem countable_inter_measurable (Σ : SigmaAlgebra' Ω) (f : ℕ → Set Ω)
    (hf : ∀ n, f n ∈ Σ.measurableSets) :
    (⋂ n, f n) ∈ Σ.measurableSets := by
  have h1 : ∀ n, (f n)ᶜ ∈ Σ.measurableSets := fun n => Σ.compl_mem (f n) (hf n)
  have h2 : (⋃ n, (f n)ᶜ) ∈ Σ.measurableSets := Σ.countable_union _ h1
  have h3 : (⋃ n, (f n)ᶜ)ᶜ ∈ Σ.measurableSets := Σ.compl_mem _ h2
  convert h3 using 1
  simp [Set.compl_iUnion]

/-- Finite unions are measurable. -/
theorem finite_union_measurable (Σ : SigmaAlgebra' Ω) {n : ℕ} (f : Fin n → Set Ω)
    (hf : ∀ i, f i ∈ Σ.measurableSets) :
    (⋃ i, f i) ∈ Σ.measurableSets := by
  have g : ℕ → Set Ω := fun k => if h : k < n then f ⟨k, h⟩ else ∅
  have hg : ∀ k, g k ∈ Σ.measurableSets := fun k => by
    simp only [g]
    split_ifs with h
    · exact hf ⟨k, h⟩
    · exact empty_measurable Σ
  have := Σ.countable_union g hg
  convert this using 1
  ext x
  simp only [Set.mem_iUnion, g]
  constructor
  · rintro ⟨i, hi⟩
    use i.val
    simp [i.isLt, hi]
  · rintro ⟨k, hk⟩
    by_cases h : k < n
    · use ⟨k, h⟩
      simpa [h] using hk
    · simp [h] at hk

/-! ## 2. Generated σ-Algebras -/

/-- The σ-algebra generated by a collection of sets. -/
def generatedSigmaAlgebra (Ω : Type*) (𝒢 : Set (Set Ω)) : SigmaAlgebra' Ω where
  measurableSets := ⋂ Σ : SigmaAlgebra' Ω, (𝒢 ⊆ Σ.measurableSets) → Σ.measurableSets
  univ_mem := by
    simp only [Set.mem_iInter]
    intro Σ _
    exact Σ.univ_mem
  compl_mem := by
    intro S hS
    simp only [Set.mem_iInter] at hS ⊢
    intro Σ h𝒢
    exact Σ.compl_mem S (hS Σ h𝒢)
  countable_union := by
    intro f hf
    simp only [Set.mem_iInter] at hf ⊢
    intro Σ h𝒢
    exact Σ.countable_union f (fun n => hf n Σ h𝒢)

/-- The generating sets are in the generated σ-algebra. -/
theorem generator_subset (Ω : Type*) (𝒢 : Set (Set Ω)) :
    𝒢 ⊆ (generatedSigmaAlgebra Ω 𝒢).measurableSets := by
  intro S hS
  simp only [generatedSigmaAlgebra, Set.mem_iInter]
  intro Σ h𝒢
  exact h𝒢 hS

/-- Generated σ-algebra is the smallest containing the generators. -/
theorem generated_smallest (Ω : Type*) (𝒢 : Set (Set Ω)) (Σ : SigmaAlgebra' Ω)
    (h : 𝒢 ⊆ Σ.measurableSets) :
    (generatedSigmaAlgebra Ω 𝒢).measurableSets ⊆ Σ.measurableSets := by
  intro S hS
  simp only [generatedSigmaAlgebra, Set.mem_iInter] at hS
  exact hS Σ h

/-! ## 3. Borel σ-Algebra -/

/-- The Borel σ-algebra is generated by open sets. -/
def borelSigmaAlgebra (X : Type*) [TopologicalSpace X] : SigmaAlgebra' X :=
  generatedSigmaAlgebra X { U | IsOpen U }

/-- Open sets are Borel measurable. -/
theorem open_measurable {X : Type*} [TopologicalSpace X] (U : Set X) (hU : IsOpen U) :
    U ∈ (borelSigmaAlgebra X).measurableSets := by
  exact generator_subset X { U | IsOpen U } hU

/-- Closed sets are Borel measurable. -/
theorem closed_measurable {X : Type*} [TopologicalSpace X] (C : Set X) (hC : IsClosed C) :
    C ∈ (borelSigmaAlgebra X).measurableSets := by
  have h1 : Cᶜ ∈ (borelSigmaAlgebra X).measurableSets := open_measurable Cᶜ hC.isOpen_compl
  exact (borelSigmaAlgebra X).compl_mem Cᶜ h1 |> by simp

/-- Continuous functions are Borel measurable. -/
theorem continuous_measurable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (f : X → Y) (hf : Continuous f) :
    ∀ U ∈ (borelSigmaAlgebra Y).measurableSets,
      f ⁻¹' U ∈ (borelSigmaAlgebra X).measurableSets := by
  sorry -- Requires careful analysis of generated σ-algebra

/-! ## 4. Product σ-Algebras -/

/-- Product σ-algebra on Ω × Ω'. -/
def productSigmaAlgebra (Ω Ω' : Type*) (Σ : SigmaAlgebra' Ω) (Σ' : SigmaAlgebra' Ω') :
    SigmaAlgebra' (Ω × Ω') :=
  generatedSigmaAlgebra (Ω × Ω')
    { R | ∃ A ∈ Σ.measurableSets, ∃ B ∈ Σ'.measurableSets, R = A ×ˢ B }

/-- Rectangles are measurable in product σ-algebra. -/
theorem rectangle_measurable {Ω Ω' : Type*} (Σ : SigmaAlgebra' Ω) (Σ' : SigmaAlgebra' Ω')
    (A : Set Ω) (B : Set Ω') (hA : A ∈ Σ.measurableSets) (hB : B ∈ Σ'.measurableSets) :
    A ×ˢ B ∈ (productSigmaAlgebra Ω Ω' Σ Σ').measurableSets := by
  exact generator_subset (Ω × Ω') _ ⟨A, hA, B, hB, rfl⟩

/-! ## 5. Dynkin Systems -/

/-- A Dynkin system (λ-system). -/
structure DynkinSystem (Ω : Type*) where
  sets : Set (Set Ω)
  univ_mem : Set.univ ∈ sets
  compl_mem : ∀ A B, A ∈ sets → B ∈ sets → A ⊆ B → B \ A ∈ sets
  countable_union_disjoint : ∀ f : ℕ → Set Ω, (∀ n, f n ∈ sets) →
    Pairwise (Disjoint on f) → (⋃ n, f n) ∈ sets

/-- Every σ-algebra is a Dynkin system. -/
theorem sigma_is_dynkin (Σ : SigmaAlgebra' Ω) : DynkinSystem Ω where
  sets := Σ.measurableSets
  univ_mem := Σ.univ_mem
  compl_mem := fun A B hA hB _ => by
    have h1 : Aᶜ ∈ Σ.measurableSets := Σ.compl_mem A hA
    have h2 : B ∩ Aᶜ ∈ Σ.measurableSets := by
      -- Use finite intersection
      sorry
    convert h2 using 1
    ext x
    simp [Set.mem_diff]
  countable_union_disjoint := fun f hf _ => Σ.countable_union f hf

/-- A π-system is closed under finite intersections. -/
def IsPiSystem (Ω : Type*) (𝒫 : Set (Set Ω)) : Prop :=
  ∀ A B, A ∈ 𝒫 → B ∈ 𝒫 → A ∩ B ∈ 𝒫

/-! ## 6. Monotone Class Theorem -/

/-- Dynkin's π-λ theorem. -/
theorem dynkin_pi_lambda (Ω : Type*) (𝒫 : Set (Set Ω)) (𝒟 : DynkinSystem Ω)
    (hπ : IsPiSystem Ω 𝒫) (h𝒫𝒟 : 𝒫 ⊆ 𝒟.sets) :
    (generatedSigmaAlgebra Ω 𝒫).measurableSets ⊆ 𝒟.sets := by
  sorry -- Dynkin's theorem

/-- Monotone class theorem. -/
theorem monotone_class (Ω : Type*) (𝒜 : Set (Set Ω))
    (h𝒜 : ∀ A B, A ∈ 𝒜 → B ∈ 𝒜 → A ∩ B ∈ 𝒜)
    (ℳ : Set (Set Ω))
    (hℳ_univ : Set.univ ∈ ℳ)
    (hℳ_mono : ∀ f : ℕ → Set Ω, (∀ n, f n ∈ ℳ) → Monotone f → (⋃ n, f n) ∈ ℳ)
    (hℳ_anti : ∀ f : ℕ → Set Ω, (∀ n, f n ∈ ℳ) → Antitone f → (⋂ n, f n) ∈ ℳ)
    (h𝒜ℳ : 𝒜 ⊆ ℳ) :
    (generatedSigmaAlgebra Ω 𝒜).measurableSets ⊆ ℳ := by
  sorry -- Monotone class theorem

/-! ## 7. Sub-σ-Algebras -/

/-- A σ-algebra is a sub-σ-algebra of another. -/
def IsSubSigmaAlgebra (Σ₁ Σ₂ : SigmaAlgebra' Ω) : Prop :=
  Σ₁.measurableSets ⊆ Σ₂.measurableSets

/-- Intersection of σ-algebras is a σ-algebra. -/
def interSigmaAlgebra (Σ₁ Σ₂ : SigmaAlgebra' Ω) : SigmaAlgebra' Ω where
  measurableSets := Σ₁.measurableSets ∩ Σ₂.measurableSets
  univ_mem := ⟨Σ₁.univ_mem, Σ₂.univ_mem⟩
  compl_mem := fun S ⟨h1, h2⟩ => ⟨Σ₁.compl_mem S h1, Σ₂.compl_mem S h2⟩
  countable_union := fun f hf =>
    ⟨Σ₁.countable_union f (fun n => (hf n).1),
     Σ₂.countable_union f (fun n => (hf n).2)⟩

/-! ## 8. Trace σ-Algebra -/

/-- The trace (restriction) of a σ-algebra to a subset. -/
def traceSigmaAlgebra (Σ : SigmaAlgebra' Ω) (A : Set Ω) : SigmaAlgebra' A where
  measurableSets := { S : Set A | ∃ T ∈ Σ.measurableSets, S = Subtype.val ⁻¹' T }
  univ_mem := ⟨Set.univ, Σ.univ_mem, by simp⟩
  compl_mem := fun S ⟨T, hT, hS⟩ => by
    use Tᶜ, Σ.compl_mem T hT
    ext x
    simp [hS]
  countable_union := fun f hf => by
    choose T hT using hf
    use ⋃ n, T n, Σ.countable_union T (fun n => (hT n).1)
    ext x
    simp [(hT · |>.2)]

end SigmaAlgebras
