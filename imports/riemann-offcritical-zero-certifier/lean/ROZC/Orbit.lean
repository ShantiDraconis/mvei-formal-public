import ROZC.Family

namespace ROZC

/-- Abstract symmetry data for the zero space.  No analytic symmetry is manufactured:
    the preservation fields must be supplied by the concrete zeta adapter. -/
structure ZeroSymmetry (M : ZetaModel) where
  reflect : M.Point → M.Point
  conjugate : M.Point → M.Point
  reflect_involutive : ∀ z, reflect (reflect z) = z
  conjugate_involutive : ∀ z, conjugate (conjugate z) = z
  commute : ∀ z, reflect (conjugate z) = conjugate (reflect z)
  reflect_zero : ∀ z, M.isZero z → M.isZero (reflect z)
  conjugate_zero : ∀ z, M.isZero z → M.isZero (conjugate z)
  reflect_nontrivial : ∀ z, M.nontrivial z → M.nontrivial (reflect z)
  conjugate_nontrivial : ∀ z, M.nontrivial z → M.nontrivial (conjugate z)
  reflect_offline : ∀ z, (¬ M.onCriticalLine z) → ¬ M.onCriticalLine (reflect z)
  conjugate_offline : ∀ z, (¬ M.onCriticalLine z) → ¬ M.onCriticalLine (conjugate z)

/-- The four formal orbit representatives generated by reflection and conjugation. -/
structure ZeroOrbit (M : ZetaModel) where
  base : M.Point
  reflected : M.Point
  conjugated : M.Point
  reflectedConjugated : M.Point

def orbitOf {M : ZetaModel} (S : ZeroSymmetry M) (z : M.Point) : ZeroOrbit M :=
  { base := z
    reflected := S.reflect z
    conjugated := S.conjugate z
    reflectedConjugated := S.reflect (S.conjugate z) }

/-- Reflection followed twice returns the starting point. -/
theorem reflect_order_two {M : ZetaModel} (S : ZeroSymmetry M) (z : M.Point) :
    S.reflect (S.reflect z) = z :=
  S.reflect_involutive z

/-- Conjugation followed twice returns the starting point. -/
theorem conjugate_order_two {M : ZetaModel} (S : ZeroSymmetry M) (z : M.Point) :
    S.conjugate (S.conjugate z) = z :=
  S.conjugate_involutive z

/-- The two involutions commute. -/
theorem symmetry_commutes {M : ZetaModel} (S : ZeroSymmetry M) (z : M.Point) :
    S.reflect (S.conjugate z) = S.conjugate (S.reflect z) :=
  S.commute z

/-- Every symmetry image of an off-critical witness remains a zeta zero. -/
theorem orbit_zeros
    {M : ZetaModel} (S : ZeroSymmetry M) (h : OffCriticalZeroWitness M) :
    M.isZero (S.reflect h.rho) ∧
    M.isZero (S.conjugate h.rho) ∧
    M.isZero (S.reflect (S.conjugate h.rho)) := by
  constructor
  · exact S.reflect_zero h.rho h.zero
  constructor
  · exact S.conjugate_zero h.rho h.zero
  · exact S.reflect_zero (S.conjugate h.rho) (S.conjugate_zero h.rho h.zero)

#print axioms reflect_order_two
#print axioms conjugate_order_two
#print axioms symmetry_commutes
#print axioms orbit_zeros

end ROZC
