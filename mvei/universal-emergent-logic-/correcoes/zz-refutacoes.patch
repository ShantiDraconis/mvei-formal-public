+open LRE.NavierStokes in
+/-- `LRE.NavierStokes.ns_closure_problem` é falso: com H = L = ℝ (normas usuais, índice s = 3 > 5/2), a projeção
+identidade (contínua, `HEq (map u) u`, limitada com C = 1), Λ = 1 e a solução constante u ≡ 0, a dinâmica fechada
+F = id satisfaz π(u(t+1)) = F(π(u(t))) para todo t. -/
+theorem ns_closure_problem_falso :
+    ¬ (∀ {s : ℝ} {H : SobolevSpace.{0} s} {L : L2Space.{0}} (π : NSProjection s H L) (Λ : FrequencyCutoff)
+      (u : ℝ → H.carrier), ¬∃ (F : L.carrier → L.carrier), ∀ t, π.map (u (t + 1)) = F (π.map (u t))) := by
+  intro h
+  let H : SobolevSpace 3 := { carrier := ℝ, sobolev_index := by norm_num }
+  let L : L2Space := { carrier := ℝ }
+  let π : NSProjection 3 H L :=
+    { map := fun x => x, continuous := continuous_id, is_inclusion := fun _ => HEq.rfl,
+      bounded := ⟨1, one_pos, fun u => by simp [H, L]⟩ }
+  exact h π ⟨1, one_pos⟩ (fun _ => (0 : ℝ)) ⟨id, fun _ => rfl⟩
+
+open LRE.NavierStokes in
+/-- `LRE.NavierStokes.singularity_is_observer_dependent` é falso: `criticalMoment` não depende do corte Λ
+(`highFrequencyResidue` e `lowFrequencyPart` ignoram Λ); com a projeção identidade de ℝ em ℝ, u ≡ 0, t = 0,
+Λ₁ = 1 e Λ₂ = 2, vale `criticalMoment` para os dois cortes (‖0‖ ≥ ‖0‖). -/
+theorem singularity_is_observer_dependent_falso :
+    ¬ (∀ {s : ℝ} {H : SobolevSpace.{0} s} {L : L2Space.{0}} (π₁ π₂ : NSProjection s H L)
+      (Λ₁ Λ₂ : FrequencyCutoff) (u : ℝ → H.carrier) (t : ℝ),
+      criticalMoment π₁ Λ₁ u t → ¬(Λ₁.1 = Λ₂.1) → ¬criticalMoment π₂ Λ₂ u t) := by
+  intro h
+  let H : SobolevSpace 3 := { carrier := ℝ, sobolev_index := by norm_num }
+  let L : L2Space := { carrier := ℝ }
+  let π : NSProjection 3 H L :=
+    { map := fun x => x, continuous := continuous_id, is_inclusion := fun _ => HEq.rfl,
+      bounded := ⟨1, one_pos, fun u => by simp [H, L]⟩ }
+  have hc : ∀ Λ : FrequencyCutoff, criticalMoment π Λ (fun _ => (0 : ℝ)) 0 := by
+    intro Λ
+    simp [criticalMoment, highFrequencyResidue, lowFrequencyPart, π, H, L]
+  exact h π π ⟨1, one_pos⟩ ⟨2, two_pos⟩ (fun _ => (0 : ℝ)) 0 (hc _) (by norm_num) (hc _)
+
+/-- `closure_problem_nonlinearity` é falso: `NS_residual_curvature` é o marcador 0 do autor, então
+`∃ u, NS_residual_curvature N u ≠ 0` é falso (o espaço de configuração é habitado: Ω = ∅, u = 0). -/
+theorem closure_problem_nonlinearity_falso :
+    ¬ (∀ (N : ℕ) (u : NSConfigSpace), ∃ (u : NSConfigSpace), NS_residual_curvature N u ≠ 0) := by
+  intro h
+  obtain ⟨v, hv⟩ := h 0 ⟨∅, Bornology.isBounded_empty, fun _ => 0, trivial⟩
+  exact hv rfl
+
+end MVEI.Refutacoes
