+/-- `LRE_RBC.blowup_of_deriv_ge_cubic` é falso como escrito: `(Tstar : ℝ := 1 / (2 * α * (R 0) ^ 2))` é só um valor
+    padrão, o teorema vale para todo Tstar. Com R = exp, α = 1 e Tstar = 0, todas as hipóteses valem em t < 0
+    (exp t > 0, exp' = exp ≥ exp³ porque exp t < 1), mas exp → 1 (e não +∞) quando t → 0⁻. -/
+theorem blowup_of_deriv_ge_cubic_falso :
+    ¬ ∀ (R : ℝ → ℝ) (α : ℝ), 0 < α → 0 < R 0 → ∀ (Tstar : ℝ),
+      (∀ t, t ∈ Iio Tstar → 0 < R t) → (∀ t, t ∈ Iio Tstar → DifferentiableAt ℝ R t) →
+      (∀ t, t ∈ Iio Tstar → deriv R t ≥ α * (R t) ^ 3) → Tendsto R (𝓝[<] Tstar) atTop := by
+  intro h
+  have hlim := h Real.exp 1 one_pos (Real.exp_pos 0) 0 (fun t _ => Real.exp_pos t)
+    (fun t _ => Real.differentiableAt_exp) (fun t ht => by
+      rw [Real.deriv_exp]
+      have h1 : Real.exp t < 1 := Real.exp_lt_one_iff.mpr ht
+      have h0 := Real.exp_pos t
+      nlinarith [mul_pos h0 (sub_pos.mpr h1), mul_pos (mul_pos h0 h0) (sub_pos.mpr h1)])
+  have hc : Tendsto Real.exp (𝓝[<] (0 : ℝ)) (𝓝 (Real.exp 0)) :=
+    Real.continuous_exp.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
+  exact not_tendsto_nhds_of_tendsto_atTop hlim _ hc
