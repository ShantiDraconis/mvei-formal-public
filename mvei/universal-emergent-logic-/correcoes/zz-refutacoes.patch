+namespace MVEI.Refutacoes
+
+open LRE in
+/-- `LRE.quantitative_closure_obstruction` é falso como escrito: closureError é o placeholder 0, então a conclusão
+    pede R = 0 num conjunto denso S; como {R = 0} é fechado, R ≡ 0, o que a estrutura Residual não impõe. Com
+    C = ℝ × ℝ, D = ℝ, π = fst, R (x, y) = ‖y‖₊ (zero exatamente na seção y = 0), curvatura Ω ≡ 1, o conjunto denso S
+    encontra {y > 0}, onde 0 ≥ α·R é falso. -/
+theorem quantitative_closure_obstruction_falso :
+    ¬ ∀ (sys : ProjectiveSystem.{0, 0}) (res : Residual sys) (dyn : Dynamics sys)
+      (conn : EhresmannConnection sys) (curv : Curvature sys conn) (cl : Closure sys),
+      hasPositiveCoupling sys res dyn → hasNonZeroCurvature sys conn curv →
+      ∃ (α : ℝ) (_ : α > 0) (S : Set sys.C) (_ : Dense S),
+        ∀ c ∈ S, closureError sys dyn cl c ≥ α * (res.R c : ℝ) := by
+  intro h
+  obtain ⟨α, hα, S, hS, hle⟩ := h
+    { C := ℝ × ℝ, D := ℝ, π := Prod.fst, π_continuous := continuous_fst, fiberDim := 1,
