+/-- `Millennium.Lemmas.gronwall_decay` é falso: a hipótese usa `deriv`, que vale 0 onde a função não é
+derivável. Para E(t) = -1 (t ≠ 1), E(1) = -1/4 e α = 1: deriv E = 0 em todo ponto (constante perto de t ≠ 1;
+não derivável em 1, por não ser contínua), então deriv E t = 0 ≤ -E t; E₀ = E 0 = -1, mas
+E 1 = -1/4 > -e⁻¹ = E₀·e^(-α·1), porque e < 4. -/
+theorem gronwall_decay_falso :
+    ¬ (∀ (E : ℝ → ℝ) (α : ℝ), α > 0 → (∀ t ≥ 0, deriv E t ≤ -α * E t) →
+      ∀ (E₀ : ℝ), E 0 = E₀ → ∀ t ≥ 0, E t ≤ E₀ * Real.exp (-α * t)) := by
+  intro h
+  let E : ℝ → ℝ := fun t => if t = 1 then -1 / 4 else -1
+  have hloc : ∀ t, t ≠ 1 → deriv E t = 0 := by
+    intro t ht
+    have : E =ᶠ[𝓝 t] fun _ => (-1 : ℝ) := by
+      filter_upwards [isOpen_ne.mem_nhds ht] with x hx
+      simp [E, hx]
+    rw [this.deriv_eq, deriv_const]
+  have hnd : ¬ DifferentiableAt ℝ E 1 := by
+    intro hd
+    have h1 : Tendsto E (𝓝[≠] 1) (𝓝 (-1)) :=
+      tendsto_const_nhds.congr' (eventually_nhdsWithin_of_forall fun x hx => by
+        have hx' : x ≠ 1 := hx
+        simp [E, hx'])
+    have h2 : Tendsto E (𝓝[≠] 1) (𝓝 (E 1)) := hd.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
+    have h3 := tendsto_nhds_unique h1 h2
+    have h4 : (-1 : ℝ) = -1 / 4 := by simpa [E] using h3
+    norm_num at h4
+  have hder : ∀ t, deriv E t = 0 := by
+    intro t
+    by_cases ht : t = 1
+    · subst ht; exact deriv_zero_of_not_differentiableAt hnd
+    · exact hloc t ht
+  have hd : ∀ t ≥ 0, deriv E t ≤ -1 * E t := by
+    intro t _
+    rw [hder]
+    by_cases ht : t = 1 <;> simp [E, ht] <;> norm_num
+  have hc := h E 1 one_pos hd (-1) (by simp [E]) 1 zero_le_one
+  -- e⁻¹ = (e^(-1/2))² > (1/2)² = 1/4, pois e^x > 1 + x para x ≠ 0
+  have h12 := Real.add_one_lt_exp (show (-1 / 2 : ℝ) ≠ 0 by norm_num)
+  have hsq : Real.exp (-1 * 1) = Real.exp (-1 / 2) * Real.exp (-1 / 2) := by
+    rw [← Real.exp_add]; norm_num
+  have hb : (1 : ℝ) / 4 < Real.exp (-1 * 1) := by
+    rw [hsq]; nlinarith [Real.exp_pos (-1 / 2)]
+  have hE1 : E 1 = -1 / 4 := by simp [E]
+  rw [hE1] at hc
+  linarith
+
+end MVEI.Refutacoes
