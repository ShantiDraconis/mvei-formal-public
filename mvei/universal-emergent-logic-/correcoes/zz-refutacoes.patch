+  intro h
+  let sys : ProjectionSystem.{0, 0} :=
+    { C := Bool, mC := ⊥, D := Bool, mD := ⊥, π := id, π_meas := measurable_id,
+      R := fun _ => 0, R_meas := measurable_const }
+  rcases MeasurableSpace.measurableSet_bot_iff.mp (h sys true) with h1 | h1
+  · have h2 : (true : Bool) ∈ FiberOver sys true := rfl
+    rw [h1] at h2
+    exact h2
