+
+namespace MVEI.Refutacoes
+
+open Filter Set Topology in
+/-- `LRE_Final.cubic_growth_implies_blowup` é falso como escrito: a hipótese só fala de `deriv R`, que vale 0 onde R
+    não é derivável, e não pede continuidade. R t = 1 + 2t para t < 1/10 e R t = −1 depois (α = 1) satisfaz
+    deriv R t ≥ (R t)³ para todo t ≥ 0 (2 ≥ (1 + 2t)³ em [0, 1/10); no salto R não é derivável e deriv = 0 ≥ −1;
+    depois deriv = 0 ≥ −1), mas R ≤ 2 em toda parte, então não tende a +∞ em nenhum T. -/
+theorem cubic_growth_implies_blowup_falso :
+    ¬ ∀ (R : ℝ → ℝ) (α : ℝ), α > 0 → R 0 > 0 → (∀ t ≥ 0, deriv R t ≥ α * (R t) ^ 3) →
+      ∃ T > 0, Tendsto R (𝓝[<] T) atTop := by
+  intro h
+  let R : ℝ → ℝ := fun t => if t < 1 / 10 then 1 + 2 * t else -1
+  have hR : ∀ t, R t = if t < 1 / 10 then 1 + 2 * t else -1 := fun t => rfl
+  have hd : ∀ t ≥ (0 : ℝ), deriv R t ≥ 1 * (R t) ^ 3 := by
+    intro t ht
+    rcases lt_trichotomy t (1 / 10) with h1 | h1 | h1
+    · have he : R =ᶠ[𝓝 t] fun s => 1 + 2 * s := by
+        filter_upwards [Iio_mem_nhds h1] with s hs
+        rw [hR, if_pos (show s < 1 / 10 from hs)]
+      have hD : deriv (fun s : ℝ => 1 + 2 * s) t = 2 := by
+        have := ((hasDerivAt_id' t).const_mul (2 : ℝ)).const_add 1
+        simpa using this.deriv
+      rw [he.deriv_eq, hD, hR, if_pos h1]
+      nlinarith [ht, h1, mul_nonneg ht ht]
+    · have hv : R (1 / 10) = -1 := by rw [hR, if_neg (lt_irrefl _)]
+      have hnd : ¬ DifferentiableAt ℝ R (1 / 10) := by
+        intro hdiff
+        have hc : Tendsto R (𝓝[<] (1 / 10 : ℝ)) (𝓝 (R (1 / 10))) :=
+          hdiff.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
+        rw [hv] at hc
+        have e1 : ∀ᶠ s in 𝓝[<] (1 / 10 : ℝ), R s < 0 := eventually_lt_of_tendsto_lt (by norm_num) hc
+        have e2 : ∀ᶠ s in 𝓝[<] (1 / 10 : ℝ), s ∈ Ioo (0 : ℝ) (1 / 10) := Ioo_mem_nhdsLT (by norm_num)
+        obtain ⟨s, hs1, hs2⟩ := (e1.and e2).exists
+        rw [hR, if_pos hs2.2] at hs1
+        linarith [hs2.1]
+      rw [h1, deriv_zero_of_not_differentiableAt hnd, hv]
+      norm_num
+    · have he : R =ᶠ[𝓝 t] fun _ => -1 := by
+        filter_upwards [Ioi_mem_nhds h1] with s hs
+        rw [hR, if_neg (not_lt.mpr (le_of_lt hs))]
+      rw [he.deriv_eq, hR, if_neg (not_lt.mpr h1.le)]
+      norm_num
+  obtain ⟨T, -, hlim⟩ := h R 1 one_pos (by rw [hR, if_pos (by norm_num)]; norm_num) hd
+  obtain ⟨s, hs⟩ := (hlim.eventually (eventually_gt_atTop 2)).exists
+  rw [hR] at hs
+  split_ifs at hs with h2 <;> linarith
+
+end MVEI.Refutacoes
