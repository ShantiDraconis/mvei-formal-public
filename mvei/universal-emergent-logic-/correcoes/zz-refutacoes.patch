+      ∃ T' ∈ Ioo t0 T, Tendsto dyn.R (𝓝[<] T') atTop := by
+  intro h
+  let dyn : ResidualDynamics :=
+    { R := fun _ => 1, κ := fun t => -2 * t - 1, D := fun _ => 0, α := 1,
