+          (fun x hx => hn x (List.mem_cons.mpr (Or.inr hx)))
+        simp only [List.zipWith_cons_cons, List.sum_cons]
+        refine ⟨add_nonneg (mul_nonneg ha.le hc) h0, ?_⟩
+        intro hl hsum b hb
+        have hac : 0 ≤ a * c := mul_nonneg ha.le hc
+        have h2 : a * c = 0 := by linarith
+        have h3 : List.sum (List.zipWith (· * ·) ws es) = 0 := by linarith
+        rcases List.mem_cons.mp hb with rfl | hb'
+        · rcases mul_eq_zero.mp h2 with h | h
+          · linarith
+          · exact h
+        · exact h1 (by simpa using hl) h3 b hb'
+  have hz : ∀ e ∈ ledger.errorVector.components, e = 0 :=
+    (key _ _ h_pos (fun b hb => (ledger.errorVector.valid b hb).1)).2 hlen hs
+  have hst : ledger.status = ProblemStatus.proved := by
+    rw [ledger.status_consistent]
+    unfold ProblemStatus.fromErrorVector
+    rw [dif_pos hz]
+  unfold isSolved
+  rw [hst]
+  rfl
 
 end ProblemLedger
