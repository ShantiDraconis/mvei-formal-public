+import Unified.TUNS
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+/-- `Tiago_Universal_Novelty_Theorem` é falso: pede, para todos os domínios A e B, uma prova φ : A = B; mas os
+construtores de `MathDomain` são distintos (A = RH, B = NS dá RH = NS, falso por `MathDomain.noConfusion`). -/
+theorem Tiago_Universal_Novelty_Theorem_falso :
+    ¬ (∃ (U : UniversalObjects) (F : MathDomain → MathDomain) (_ : MathDomain.Functor F),
+      ∀ (A B : MathDomain), ∃ (φ : A = B),
+      (U.spectrum = {«λ» : ℂ | ∀ A, ∃ x, spectralValue A x = «λ»}) ∧
+      (U.energy.1 + U.energy.2.1 + U.energy.2.2.1 + U.energy.2.2.2 = 0) ∧
+      (∀ t, U.timeParam t A = U.timeParam t B)) := by
+  rintro ⟨U, F, _, h⟩
+  obtain ⟨φ, _⟩ := h MathDomain.RH MathDomain.NS
+  exact MathDomain.noConfusion φ
+
+end MVEI.Refutacoes
