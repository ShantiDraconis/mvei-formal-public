+import Contaminated.NotImported.lean4.MillenniumFramework
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+open LocalGlobalFramework in
+/-- `LocalGlobalFramework.bridge_transfer` é falso (o próprio autor anota que falta injetividade de mapLocal):
+F₁ = (Bool, Bool, Bool, id, id) tem ponte (Φ = id); F₂ = (Bool, Unit, Bool, const (), id) não tem (Φ () teria de
+valer true e false); m = (id, const (), id) é morfismo com mapX sobrejetiva. -/
+theorem bridge_transfer_falso :
+    ¬ (∀ {F₁ F₂ : Framework.{0, 0, 0}} (m : FrameworkMorphism F₁ F₂),
+      Function.Surjective m.mapX → HasBridge F₁ → HasBridge F₂) := by
+  intro h
+  let F₁ : Framework.{0, 0, 0} := ⟨Bool, Bool, Bool, id, id⟩
+  let F₂ : Framework.{0, 0, 0} := ⟨Bool, Unit, Bool, fun _ => (), id⟩
+  let m : FrameworkMorphism F₁ F₂ := ⟨id, fun _ => (), id, fun _ => rfl, fun _ => rfl⟩
+  obtain ⟨Φ, hΦ⟩ := h m (fun y => ⟨y, rfl⟩) ⟨id, fun _ => rfl⟩
+  have h1 : Φ () = true := hΦ true
+  have h2 : Φ () = false := hΦ false
+  rw [h1] at h2
+  exact Bool.noConfusion h2
+
+end MVEI.Refutacoes
