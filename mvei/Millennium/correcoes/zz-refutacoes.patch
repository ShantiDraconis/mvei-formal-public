+import TUNS.UniversalSpectrum
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+open TUNS in
+/-- `TUNS.universal_spectrum_unique` é falso: `UniversalSpectrum` tem o campo de dados `universalMeasure : ℝ → ℝ≥0`;
+com todos os espectros vazios (compatibilidade trivial), as medidas 0 e 1 dão dois elementos distintos. -/
+theorem universal_spectrum_unique_falso : ¬ (∀ σ σ' : UniversalSpectrum, σ = σ') := by
+  intro h
+  let σ : UniversalSpectrum := ⟨fun _ => ⟨∅, 0⟩, fun _ _ _ => by simp, 0⟩
+  let σ' : UniversalSpectrum := ⟨fun _ => ⟨∅, 0⟩, fun _ _ _ => by simp, 1⟩
+  have h1 := congrArg (fun s => s.universalMeasure 0) (h σ σ')
+  simp [σ, σ'] at h1
+
+end MVEI.Refutacoes
