+import Universe00.Core.Ledger
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+/-- `ProblemLedger.zero_error_means_solved` é falso: com pesos 1 e 0, o erro total só vê o primeiro parâmetro; um
+    segundo parâmetro com erro 1 (e peso 0) deixa o total em 0 e o status em aberto. -/
+theorem zero_error_means_solved_falso :
+    ¬ ∀ ledger : ProblemLedger, ledger.totalError = 0 → ledger.isSolved := by
+  intro h
+  let p0 : MeasuredParameter ℝ := ⟨0, 0, by norm_num⟩
+  let p1 : MeasuredParameter ℝ := ⟨0, 1, by norm_num⟩
+  let ev : ErrorVector := ⟨[0, 1], by intro e he; simp at he; rcases he with rfl | rfl <;> norm_num⟩
+  have hnz : ¬ ∀ e ∈ ev.components, e = 0 := by
+    intro hz; have := hz 1 (by simp [ev]); norm_num at this
+  let L : ProblemLedger :=
+    { name := "contraexemplo"
+      parameters := [p0, p1]
+      weights := [1, 0]
+      errorVector := ev
+      totalError := 0
+      status := ProblemStatus.fromErrorVector ev
+      param_weight_consistent := rfl
+      weights_valid := ⟨by intro w hw; simp at hw; rcases hw with rfl | rfl <;> norm_num, by norm_num⟩
+      error_vector_consistent := rfl
+      error_components_match := rfl
+      total_error_is_aggregate := by simp [aggregateError, ev]
+      status_consistent := rfl }
+  have hs := h L rfl
+  simp only [ProblemLedger.isSolved, L, ProblemStatus.fromErrorVector, dif_neg hnz] at hs
+  exact absurd hs (by decide)
+
+end MVEI.Refutacoes
