+import Millennium.Riemann.IConstant.DeltaCollapse
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+open Millennium.Riemann Millennium.Riemann.IConstant in
+/-- `collapse_equiv_iff` é falso: Δ guarda o desvio de Re(s) na componente indeterminada, então
+    0 e 1 têm a mesma parte imaginária mas Δ 0 ≠ Δ 1 (indet −1/2 contra 1/2). -/
+theorem collapse_equiv_iff_falso :
+    ¬ ∀ (s t : CollapseComplex), collapse_equiv s t ↔ s.im = t.im := by
+  intro h
+  have h1 := (h ⟨0, 0, 0⟩ ⟨1, 0, 0⟩).2 rfl
+  have h2 := congrArg CollapseComplex.indet h1
+  simp only [Δ] at h2
+  norm_num at h2
+
+end MVEI.Refutacoes
