+import MillenniumRiemann.Theorems
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+/-- `Collapse.CollapseComplex.normI_smul_nonneg` é falso: ofReal λ = (λ, 0, 0) multiplica a componente
+    indeterminada por 0 (a componente indet do produto é κ₁κ₂), então para z = (0, 0, 1) e λ = 1 o lado
+    esquerdo é normI (0, 0, 0) = 0 e o direito é 1 · (0 + |1|) = 1. -/
+theorem normI_smul_nonneg_falso :
+    ¬ ∀ (l : ℝ) (z : Collapse.CollapseComplex), 0 ≤ l →
+      Collapse.CollapseComplex.normI (Collapse.CollapseComplex.ofReal l * z) =
+        l * Collapse.CollapseComplex.normI z := by
+  intro h
+  have h1 := h 1 ⟨0, 0, 1⟩ zero_le_one
+  have e : Collapse.CollapseComplex.ofReal 1 * (⟨0, 0, 1⟩ : Collapse.CollapseComplex) = ⟨0, 0, 0⟩ := by
+    show Collapse.CollapseComplex.mul _ _ = _
+    simp [Collapse.CollapseComplex.mul, Collapse.CollapseComplex.ofReal]
+  rw [e] at h1
+  simp [Collapse.CollapseComplex.normI] at h1
+
+end MVEI.Refutacoes
