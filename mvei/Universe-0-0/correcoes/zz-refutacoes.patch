+/-- `Universe00.Impossibility.zero_division_requires_nonclassical_structure` é falso como escrito (sem a hipótese
+    DivZeroConst td, isto é, div 1 0 = div 0 0): a divisão totalizada td.div a b = (se b = 0 então a senão a / b)
+    concorda com a divisão do corpo fora do zero e é injetiva em a para todo b, logo tem cancelação forte (em ℚ). -/
+theorem zero_division_requires_nonclassical_structure_falso :
+    ¬ ∀ (F : Type) [Field F] [Nontrivial F] (td : TotalizedDivision F), ¬StrongCancellation td := by
+  intro h
+  refine h ℚ ⟨fun a b => if b = 0 then a else a / b, fun a b hb => if_neg hb⟩ ?_
+  intro a c b hab
+  by_cases hb : b = 0
+  · simpa [hb] using hab
+  · simp only [if_neg hb] at hab
+    exact (div_left_inj' hb).mp hab
