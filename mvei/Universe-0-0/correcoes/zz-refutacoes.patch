+/-- `Universe00.TotalizedAlgebra.add_I_comm` é falso como o Lean lê: `[Add α]` e `[AddCommGroup α]` são duas
+    instâncias independentes, e add_I usa a primeira, que não precisa ser comutativa. Em ℤ com a soma
+    "projeção à esquerda" (a + b := a), add_I (val 1) (val 2) = val 1 ≠ val 2 = add_I (val 2) (val 1). -/
+theorem add_I_comm_falso :
+    ¬ ∀ {α : Type} [Add α] [AddCommGroup α] (a b : Universe00.TotalizedAlgebra.Extended α),
+      Universe00.TotalizedAlgebra.add_I a b = Universe00.TotalizedAlgebra.add_I b a := by
+  intro H
+  have h := @H ℤ ⟨fun a _ => a⟩ inferInstance (.val 1) (.val 2)
+  simp only [Universe00.TotalizedAlgebra.add_I] at h
+  have h2 := Universe00.TotalizedAlgebra.Extended.val.inj h
+  exact absurd h2 (by decide)
+
+end MVEI.Refutacoes
