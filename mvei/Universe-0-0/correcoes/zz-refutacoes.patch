+  let z : MathematicalStateSpace := ⟨0, 0, by simp, by simp⟩
+  let C0 : UniversalUnificationOperator :=
+    { op := fun _ => z
+      kernel := ⟨fun _ => 0, by simp, by simp, trivial⟩
+      integralForm := by intro ψ x; simp [z]
+      selfAdjoint := by intro ψ φ; simp [MathematicalStateSpace.innerProduct, z]
+      isFredholm := trivial
+      isBounded := ⟨0, by
+        intro ψ
+        simp [MathematicalStateSpace.norm, MathematicalStateSpace.innerProduct, z]⟩ }
+  have hphys : ∫⁻ x, (‖(Set.indicator ({0} : Set (Fin 4 → ℝ)) (fun _ => (1 : ℂ))) x‖₊ : ENNReal) ^ 2
