+  have h1 : Filter.Tendsto (fun n : ℕ => ‖RiemannHypothesis.InfiniteFrequency.inverseState n φ.θ‖)
+      Filter.atTop Filter.atTop := by
+    simp_rw [hn]
+    exact Filter.tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop
