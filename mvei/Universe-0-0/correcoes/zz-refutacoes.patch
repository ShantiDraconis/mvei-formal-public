+theorem i_phase_properties_falso :
+    ¬ ∀ {α β : Type} {C : ContinuousDomain.{0, 0} α} {D : DiscreteDomain.{0, 0} β}
+      (π : Projection C D) (ι : Reconstruction C D π)
