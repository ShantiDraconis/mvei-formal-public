+      (_ : ∀ x, norm x = 0 ↔ x = C.zero) (x : C.carrier),
+      let I := i_phase_from_residue π ι norm ε x
+      (residue π ι x = C.zero → I = 0) ∧ (0 ≤ I) ∧ (I < 1) := by
+  intro H
+  let C : ContinuousDomain.{0, 0} Unit :=
+    { carrier := ℤ, add := (· + ·), neg := (- ·), zero := 0, add_assoc := add_assoc,
+      add_comm := add_comm, zero_add := zero_add, add_zero := add_zero,
+      add_left_neg := neg_add_cancel }
+  let D : DiscreteDomain.{0, 0} Unit :=
+    { carrier := Unit, add := fun _ _ => (), zero := (), equiv := fun _ _ => True,
+      add_assoc := fun _ _ _ => rfl, add_comm := fun _ _ => rfl, zero_add := fun _ => rfl,
+      equiv_refl := fun _ => trivial, equiv_symm := fun _ _ _ => trivial,
