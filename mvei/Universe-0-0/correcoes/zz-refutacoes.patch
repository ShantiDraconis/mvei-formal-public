+    (O axioma `inverse_state_limit` do arquivo afirma essa convergência e é, pelo mesmo cálculo, falso.) -/
+theorem zeros_not_unique_falso :
+    ¬ ∀ (s : RiemannHypothesis.InfiniteFrequency.ComplexVar) (_h : s.sigma = 1/2),
+      ∃ (interference : RiemannHypothesis.InfiniteFrequency.PhaseInterference),
+        interference.primary.s = s := by
+  intro H
+  obtain ⟨φ, -⟩ := H { sigma := 1/2, t := 0 } rfl
+  obtain ⟨L, hL⟩ := φ.h_interference
+  have hn : ∀ n : ℕ, ‖RiemannHypothesis.InfiniteFrequency.inverseState n φ.θ‖ = (n : ℝ) + 2 := by
+    intro n
+    simp only [RiemannHypothesis.InfiniteFrequency.inverseState, norm_mul, Complex.norm_exp,
+      Complex.mul_re, Complex.I_re, Complex.I_im, Complex.ofReal_re, Complex.ofReal_im]
+    have h0 : (0 : ℝ) * φ.θ - 1 * 0 = 0 := by ring
+    have e : (1 : ℂ) / 2 - (2.5 + ((n : ℝ) : ℂ)) = -((((n : ℝ) + 2 : ℝ)) : ℂ) := by
+      push_cast
+      norm_num
