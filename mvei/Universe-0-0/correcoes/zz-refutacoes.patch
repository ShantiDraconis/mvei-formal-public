+        = Set.indicator ({0} : Set (Fin 4 → ℝ)) (fun _ => (1 : ℝ≥0∞)) := by
+      funext x
+      by_cases hx : x ∈ ({0} : Set (Fin 4 → ℝ)) <;> simp [Set.indicator_of_mem, Set.indicator_of_not_mem, hx]
+    rw [this, MeasureTheory.lintegral_indicator_const (MeasurableSet.singleton 0)]
+    simp
+  let ψ : MathematicalStateSpace :=
+    ⟨0, Set.indicator ({0} : Set (Fin 4 → ℝ)) (fun _ => (1 : ℂ)), by simp, hphys⟩
+  have hmem : Complex.I ∈ C0.Spectrum := by
