+física `1_{0}` (não nula, de quadrado integrável) é autovetor de qualquer `λ` pela definição de
+`Spectrum` (que só olha a componente de teoria dos números); com `λ = I`, `λ.im = 1 ≠ 0`. -/
+theorem spectrum_is_real_falso :
+    ¬ (∀ (C : UniversalUnificationOperator), ∀ «λ» ∈ C.Spectrum, «λ».im = 0) := by
+  intro h
+  let z : MathematicalStateSpace := ⟨0, 0, by simp, by simp⟩
+  let C0 : UniversalUnificationOperator :=
+    { op := fun _ => z
+      kernel := ⟨fun _ => 0, by simp, by simp, trivial⟩
+      integralForm := by intro ψ x; simp [z]
+      selfAdjoint := by intro ψ φ; simp [MathematicalStateSpace.innerProduct, z]
+      isFredholm := trivial
+      isBounded := ⟨0, by
+        intro ψ
+        simp [MathematicalStateSpace.norm, MathematicalStateSpace.innerProduct, z]⟩ }
+  have hphys : ∫⁻ x, (‖(Set.indicator ({0} : Set (Fin 4 → ℝ)) (fun _ => (1 : ℂ))) x‖₊ : ℝ≥0∞) ^ 2 < ∞ := by
