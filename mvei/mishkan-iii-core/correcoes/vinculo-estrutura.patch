+-- teoremas finais
+axiom canonical_encoding : HarappaSign → ModernConcept → Encoding
+axiom representation_theorem : ∀ {h : HarappaSign} {m : ModernConcept}, represents (canonical_encoding h m) h m
+axiom precedence_theorem : ∀ {h : HarappaSign} {m : ModernConcept}, temporal_precedence h m
+opaque logical_equivalence : HarappaSign → ModernConcept → Prop
+axiom equivalence_theorem : ∀ {h : HarappaSign} {m : ModernConcept}, logical_equivalence h m
+opaque expressible_in_modern : MathematicalConcept → Prop
+opaque expressible_in_harappa : MathematicalConcept → Prop
+axiom backward_translation : ∀ {c : MathematicalConcept}, expressible_in_modern c → expressible_in_harappa c
+opaque valid_in_harappa : Derivation → Prop
+opaque valid_in_modern : Derivation → Prop
+axiom forward_translation : ∀ {d : Derivation}, valid_in_harappa d → valid_in_modern d
+axiom harappa_upper_bound : ∀ (s : HarappaSign), s.date < -1900
+axiom modern_lower_bound : ∀ (m : ModernTheorem), m.date > 1600
+axiom implication_preservation : ∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
+  encodes h1 m1 → encodes h2 m2 → (h1 → h2) → (m1 → m2)
+axiom reverse_implication : ∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
+  encodes h1 m1 → encodes h2 m2 → (m1 → m2) → (h1 → h2)
+opaque phase_zero : Knowledge → Prop
+opaque logical_validity : Knowledge → Prop
+opaque archaeological_verification : Knowledge → Prop
+axiom phase_zero_precedence : ∀ {k : Knowledge} {β : Sort v} {b : β}, phase_zero k → temporal_precedence k b
+axiom phase_zero_logic : ∀ {k : Knowledge}, phase_zero k → logical_validity k
+axiom phase_zero_archaeology : ∀ {k : Knowledge}, phase_zero k → archaeological_verification k
