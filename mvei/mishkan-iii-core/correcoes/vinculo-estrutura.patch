+opaque BSDProblem : Type
+instance : ProblemaMilenio BSDProblem := ⟨⟩
+opaque BSDAspect : Type
+opaque BSDAspect.id : BSDAspect → Nat
+/-- `correspondence_N_BSD` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom bsd_encoding : ∀ {h : HarappaSign} {m : BSDProblem} {k : Nat}, h.id = k → codificaRel BSDProblem h m
+axiom aspect_encoding_bsd : ∀ {h : HarappaSign} {a : BSDAspect} {k : Nat}, a.id = k → encodes_aspect h a
