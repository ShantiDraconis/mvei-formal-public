+/-! ## Ligações com o catálogo do autor -/
+
+namespace HarappaCatalog.HarappaSign
+/-- `id` dos arquivos gerados = `index` do catálogo. -/
+def id (s : HarappaCatalog.HarappaSign) : Nat := s.index
+/-- `number` (TEMPLE_ARCHITECTURE) = `index`. -/
+def number (s : HarappaCatalog.HarappaSign) : Nat := s.index
+/-- Data do sinal: o catálogo não tem; fica opaca. -/
+opaque date : HarappaCatalog.HarappaSign → Int
+end HarappaCatalog.HarappaSign
+
+namespace MveiEstrutura.Mishkan
+
+abbrev HarappaSign := HarappaCatalog.HarappaSign
+
+instance : Inhabited HarappaSign := ⟨HarappaCatalog.sign_001⟩
+
+/-- Lei de datação que as 600 provas `precedence_N` afirmam (h1 : h.date = −2600 + N), restrita ao intervalo em
