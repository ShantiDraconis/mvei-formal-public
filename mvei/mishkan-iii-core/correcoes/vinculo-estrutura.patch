+-- integration_N_*
+opaque equivalent : HarappaSystem → ModernSystem → Prop
+axiom translate : HarappaSystem → ModernSystem → Translation
+opaque presF : Translation → HarappaFormula → Prop
+def preserves_semantics (t : Translation) : Prop := ∀ formula : HarappaFormula, presF t formula
+axiom semantic_preservation : ∀ {h : HarappaSystem} {m : ModernSystem} {f : HarappaFormula},
+  equivalent h m → presF (translate h m) f
+opaque translation_function : (HarappaFormula → ModernFormula) → Prop
+abbrev bijective (f : HarappaFormula → ModernFormula) : Prop := Function.Injective f ∧ Function.Surjective f
+axiom injective_translation : ∀ {f : HarappaFormula → ModernFormula}, translation_function f → Function.Injective f
+axiom surjective_translation : ∀ {f : HarappaFormula → ModernFormula}, translation_function f → Function.Surjective f
+opaque isomorphic : HarappaStructure → ModernStructure → Prop
+opaque equivalent_theories : HarappaStructure → ModernStructure → Prop
+axiom theory_equivalence : ∀ {h : HarappaStructure} {m : ModernStructure}, isomorphic h m → equivalent_theories h m
