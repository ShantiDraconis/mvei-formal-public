+instance : ProblemaMilenio PoincareProblem := ⟨⟩
+opaque PoincareAspect : Type
+opaque PoincareAspect.id : PoincareAspect → Nat
+/-- `correspondence_N_Poincare` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom poincare_encoding : ∀ {h : HarappaSign} {m : PoincareProblem} {k : Nat}, h.id = k → codificaRel PoincareProblem h m
