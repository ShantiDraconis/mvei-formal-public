+theorem modernDate_eq : ∀ n, n < 601 → 1 ≤ n → modernDate n = modernDates.getD (n - 1) 0 := by decide
+
+axiom datacao_moderna : ∀ (m : ModernConcept) {n : Nat}, m.id = n → 1 ≤ n ∧ n ≤ 600 → m.date = modernDate n
+
+-- verdade de um sinal / conceito (logical_preservation escreve `h1 → h2` com h1 : HarappaSign)
+opaque signVerdade : HarappaSign → Prop
+opaque conceitoVerdade : ModernConcept → Prop
+instance : CoeSort HarappaSign Prop := ⟨signVerdade⟩
+instance : CoeSort ModernConcept Prop := ⟨conceitoVerdade⟩
+
+-- encodes / related / represents são usados com vários tipos
+opaque codificaRel (α : Type) : HarappaSign → α → Prop
+def encodes {α : Type} (h : HarappaSign) (m : α) : Prop := codificaRel α h m
+opaque relatedRel (α : Type) : α → α → Prop
+def related {α : Type} (a b : α) : Prop := relatedRel α a b
+class Representa (α β : Type) (γ : outParam Type) where
+  represents : α → β → γ
+export Representa (represents)
+opaque repr2 : HarappaSign → ModernTheorem → Prop
+opaque repr3 : Encoding → HarappaSign → ModernConcept → Prop
+instance : Representa HarappaSign ModernTheorem Prop := ⟨repr2⟩
+instance : Representa Encoding HarappaSign (ModernConcept → Prop) := ⟨repr3⟩
+opaque precedeRel (α : Sort u) (β : Sort v) : α → β → Prop
+def temporal_precedence {α : Sort u} {β : Sort v} (a : α) (b : β) : Prop := precedeRel α β a b
+
+-- consistency_N
+opaque compat : HarappaSign → HarappaSign → Prop
+def compatible (s1 s2 : HarappaSign) : Prop := compat s1 s2
+/-- O corpus escolhe pares de ids arbitrários e usa as hipóteses de id só como argumentos: a lei que ele assume é que
+    quaisquer dois sinais são compatíveis. -/
+axiom compatibility_axiom : ∀ {s1 s2 : HarappaSign} {a b : Nat}, s1.id = a → s2.id = b → compat s1 s2
+
+-- completeness_N, _strong, _equivalence
+opaque modern_concept : MathConcept → Prop
+axiom encoding_theorem : ∀ {s : HarappaSign} {c : MathConcept}, modern_concept c → encodes s c
+opaque expressible : Prop → Prop
+opaque encodes_list : List HarappaSign → Prop → Prop
+axiom list_encoding : ∀ {p : Prop}, expressible p → ∃ signs : List HarappaSign, encodes_list signs p
+opaque traduzHM : HarappaLogic → ModernLogic → HarappaExpr → Prop
+opaque traduzMH : HarappaLogic → ModernLogic → ModernExpr → Prop
+abbrev equivalent_expressive_power (h : HarappaLogic) (m : ModernLogic) : Prop :=
+  (∀ e : HarappaExpr, traduzHM h m e) ∧ (∀ e : ModernExpr, traduzMH h m e)
+axiom h_to_m_translation : ∀ {h : HarappaLogic} {m : ModernLogic} {e : HarappaExpr}, traduzHM h m e
+axiom m_to_h_translation : ∀ {h : HarappaLogic} {m : ModernLogic} {e : ModernExpr}, traduzMH h m e
+
+-- correspondence_N_*
+/-- Forma justa do que `correspondence_N_bijective` pede. O par do gerador (`representation_exists`: todo sinal
+    representa m; `representation_unique`) só tem modelo com `ModernTheorem` vazio, porque o catálogo tem sinais
+    distintos (`Indeterminado.Refutacoes.representacao_classica_inconsistente`); este tem modelo com
+    `represents h m := h = f m` para qualquer `f`. -/
+axiom representation_bijective : ∀ (m : ModernTheorem), ∃! (h : HarappaSign), represents h m
+axiom structure_preservation : ∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
+  encodes h1 m1 → encodes h2 m2 → related h1 h2 → related m1 m2
+
+-- meta_N_* (definições-padrão; Formula = Prop porque o enunciado escreve `¬formula`)
+opaque derivable : LogicalSystem → Formula → Prop
+opaque derives : LogicalSystem → Prop
+opaque valid : Formula → Prop
+abbrev sound (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → valid formula
+abbrev complete (s : LogicalSystem) : Prop := ∀ (formula : Formula), valid formula → derivable s formula
+abbrev consistent (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → derivable s (¬formula) → False
+opaque decidable_system : LogicalSystem → Prop
+axiom soundness_lemma : ∀ {s : LogicalSystem} {f : Formula}, derives s → derivable s f → valid f
+
+-- verify_<P>_N e verify_<P>_N_encoding
+class ProblemaMilenio (α : Type) : Prop
+opaque discoveryDate (α : Type) : α → Int
+def discovery_date {α : Type} (p : α) : Int := discoveryDate α p
+axiom modern_discovery : ∀ {α : Type} [ProblemaMilenio α] {p : α}, discovery_date p > 1800
+/-- `verify_<P>_N` aplica a lei a qualquer id: todo sinal é anterior a −1900 (compatível com `harappa_period`). -/
+axiom harappa_period_upper : ∀ {h : HarappaSign} {k : Nat}, h.id = k → h.date < -1900
+opaque codificaAspecto (α : Type) : HarappaSign → α → Prop
+def encodes_aspect {α : Type} (h : HarappaSign) (a : α) : Prop := codificaAspecto α h a
+opaque PNPProblem : Type
+instance : ProblemaMilenio PNPProblem := ⟨⟩
+opaque PNPAspect : Type
+opaque PNPAspect.id : PNPAspect → Nat
+/-- `correspondence_N_PNP` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom pnp_encoding : ∀ {h : HarappaSign} {m : PNPProblem} {k : Nat}, h.id = k → codificaRel PNPProblem h m
+axiom aspect_encoding_pnp : ∀ {h : HarappaSign} {a : PNPAspect} {k : Nat}, a.id = k → encodes_aspect h a
+
+opaque RiemannProblem : Type
+instance : ProblemaMilenio RiemannProblem := ⟨⟩
+opaque RiemannAspect : Type
+opaque RiemannAspect.id : RiemannAspect → Nat
+/-- `correspondence_N_Riemann` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom riemann_encoding : ∀ {h : HarappaSign} {m : RiemannProblem} {k : Nat}, h.id = k → codificaRel RiemannProblem h m
+axiom aspect_encoding_riemann : ∀ {h : HarappaSign} {a : RiemannAspect} {k : Nat}, a.id = k → encodes_aspect h a
+
+opaque HodgeProblem : Type
+instance : ProblemaMilenio HodgeProblem := ⟨⟩
+opaque HodgeAspect : Type
+opaque HodgeAspect.id : HodgeAspect → Nat
+/-- `correspondence_N_Hodge` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom hodge_encoding : ∀ {h : HarappaSign} {m : HodgeProblem} {k : Nat}, h.id = k → codificaRel HodgeProblem h m
+axiom aspect_encoding_hodge : ∀ {h : HarappaSign} {a : HodgeAspect} {k : Nat}, a.id = k → encodes_aspect h a
+
+opaque YangMillsProblem : Type
+instance : ProblemaMilenio YangMillsProblem := ⟨⟩
+opaque YangMillsAspect : Type
+opaque YangMillsAspect.id : YangMillsAspect → Nat
+/-- `correspondence_N_YangMills` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom yangmills_encoding : ∀ {h : HarappaSign} {m : YangMillsProblem} {k : Nat}, h.id = k → codificaRel YangMillsProblem h m
+axiom aspect_encoding_yangmills : ∀ {h : HarappaSign} {a : YangMillsAspect} {k : Nat}, a.id = k → encodes_aspect h a
+
+opaque NavierStokesProblem : Type
+instance : ProblemaMilenio NavierStokesProblem := ⟨⟩
+opaque NavierStokesAspect : Type
+opaque NavierStokesAspect.id : NavierStokesAspect → Nat
+/-- `correspondence_N_NavierStokes` usa o id só como argumento: todo sinal codifica todo problema. -/
+axiom navierstokes_encoding : ∀ {h : HarappaSign} {m : NavierStokesProblem} {k : Nat}, h.id = k → codificaRel NavierStokesProblem h m
+axiom aspect_encoding_navierstokes : ∀ {h : HarappaSign} {a : NavierStokesAspect} {k : Nat}, a.id = k → encodes_aspect h a
