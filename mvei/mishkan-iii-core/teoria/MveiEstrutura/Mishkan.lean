/-
  MveiEstrutura/Mishkan.lean — CAMADA CONCRETA (reformulacoes/TeoriaMishkan; MVEI, NÃO é do autor). Gerado por
  tools/teoria_mishkan.py a partir do texto da camada abstrata (tools/estrutura_mishkan.py).

  Os MESMOS nomes da camada abstrata. Cada `opaque` recebe uma definição a partir dos dados do corpus
  (MveiEstrutura/Teoria: Gramatica, Aritmetica, Dados) e cada `axiom` vira `theorem` com o MESMO enunciado (o texto é
  copiado da camada abstrata pela ferramenta). Os tipos são habitados por dados reais: os 417 sinais do catálogo, os
  599 conceitos modernos do gerador (o 425 é a única exclusão forçada: a data 1600 dele contradiz
  `modern_mathematics` do autor), os 15 teoremas e os 22 marcos modernos da TIMELINE, os 70 eventos harappianos, as
  600 evidências, os 417 pilares do templo, os 7 problemas do milênio com o ano real da formulação. As relações que
  as leis afirmam totais (todo sinal codifica todo problema, todo par de sinais é compatível…) são critérios dos dados
  que valem para todos os elementos: a lei passa a ser a verificação desse critério.
-/
import archaeology.HARAPPA_CATALOG
import MveiEstrutura.Teoria.Dados

noncomputable section

set_option autoImplicit false

universe u v

/-! ## Ligações com o catálogo do autor -/

namespace HarappaCatalog.HarappaSign
/-- `id` dos arquivos gerados = `index` do catálogo. -/
def id (s : HarappaCatalog.HarappaSign) : Nat := s.index
/-- `number` (TEMPLE_ARCHITECTURE) = `index`. -/
def number (s : HarappaCatalog.HarappaSign) : Nat := s.index
/-- Data do sinal: a lei do gerador (−2600 + N, as 600 provas `precedence_N`), saturada em N = 600 para
    registros fora do corpus; a tolerância é a incerteza de C14 do gerador (MveiTeoria.Dados). -/
def date (s : HarappaCatalog.HarappaSign) : Int := -2600 + ((min s.index 600 : Nat) : Int)
end HarappaCatalog.HarappaSign

namespace MveiEstrutura.Mishkan

abbrev HarappaSign := HarappaCatalog.HarappaSign

instance : Inhabited HarappaSign := ⟨HarappaCatalog.sign_001⟩

/-- Lei de datação que as 600 provas `precedence_N` afirmam (h1 : h.date = −2600 + N), restrita ao intervalo em
    que o corpus a usa (N ≤ 600; acima disso valeria > −1900, contra `harappa_period` do próprio autor). -/
theorem datacao_harappa : ∀ (h : HarappaSign) {n : Nat}, h.id = n → n ≤ 600 → h.date = -2600 + (n : Int) := by
  intro h n hid hn
  subst hid
  show -2600 + ((min h.index 600 : Nat) : Int) = -2600 + (h.index : Int)
  rw [Nat.min_eq_left (show h.index ≤ 600 from hn)]


/-! ## FORMAL_VERIFICATIONS -/
namespace Formal

abbrev Formula : Type := Prop

/-- Conceito moderno: os conceitos 1 … 600 do gerador, menos o 425 (MveiTeoria.obstrucao_425). -/
structure ModernConcept where
  id : Nat
  valido : 1 ≤ id ∧ id ≤ 600 ∧ id ≠ 425
/-- Data do conceito: o gerador das 600 datas do corpus, 1600 + (N mod 425). -/
def ModernConcept.date (m : ModernConcept) : Int := MveiTeoria.geradorModerno m.id
/-- Teorema moderno: os 15 resultados datados da TIMELINE do autor (Descartes 1637 … Perelman 2002). -/
structure ModernTheorem where
  idx : Fin 15

def ModernTheorem.marco (m : ModernTheorem) : MveiTeoria.Marco :=
  MveiTeoria.teoremasModernos.getD m.idx.val default
def ModernTheorem.date (m : ModernTheorem) : Int := m.marco.ano
/-- Conceito matemático, pelo nome (símbolo moderno). -/
structure MathConcept where
  nome : String
structure MathematicalConcept where
  nome : String
/-- A lógica da língua dos sinais (MveiTeoria.FormulaH, evalH). -/
inductive HarappaLogic
  | linguaDosSinais
/-- A lógica modal proposicional clássica (MveiTeoria.FormulaM, evalM). -/
inductive ModernLogic
  | logicaModalClassica
abbrev HarappaExpr : Type := MveiTeoria.FormulaH
abbrev ModernExpr : Type := MveiTeoria.FormulaM
/-- Sistema lógico: a lista dos seus axiomas. -/
abbrev LogicalSystem : Type := List Prop
/-- Sistema: uma valoração dos sinais-átomo nos cinco sítios. -/
structure HarappaSystem where
  v : MveiTeoria.Valoracao
structure ModernSystem where
  v : MveiTeoria.Valoracao
abbrev HarappaFormula : Type := MveiTeoria.FormulaH
abbrev ModernFormula : Type := MveiTeoria.FormulaM
structure Translation where
  origem : HarappaSystem
  destino : ModernSystem
/-- Estrutura (modelo): valoração nos cinco sítios. -/
structure HarappaStructure where
  v : MveiTeoria.Valoracao
structure ModernStructure where
  v : MveiTeoria.Valoracao
/-- Codificação: o par (sinal, conceito). -/
structure Encoding where
  sinal : Nat
  conceito : Nat
/-- Derivação: a fórmula derivada. -/
abbrev Derivation : Type := MveiTeoria.FormulaH
/-- Conhecimento: o que o sinal de índice `sinal` carrega. -/
structure Knowledge where
  sinal : Nat

def Knowledge.date (k : Knowledge) : Int := -2600 + ((min k.sinal 600 : Nat) : Int)
/-- Artefato: uma das 600 evidências do gerador. -/
structure Artifact where
  idx : Fin 600
def Artifact.date (a : Artifact) : Int := MveiTeoria.dataSinal (a.idx.val + 1)

