theorem modernDate_eq : ∀ n, n < 601 → 1 ≤ n → modernDate n = modernDates.getD (n - 1) 0 := by decide

/-- As 600 datas modernas do corpus são o gerador 1600 + (N mod 425) (MveiTeoria.Dados). -/
theorem modernDate_gerador : ∀ n < 601, 1 ≤ n → modernDate n = MveiTeoria.geradorModerno n := by
  decide +kernel

theorem datacao_moderna : ∀ (m : ModernConcept) {n : Nat}, m.id = n → 1 ≤ n ∧ n ≤ 600 → m.date = modernDate n := by
  intro m n hid hn
  subst hid
  exact (modernDate_gerador m.id (by omega) hn.1).symm

-- verdade de um sinal / conceito (logical_preservation escreve `h1 → h2` com h1 : HarappaSign)
/-- Um sinal é verdadeiro quando está atestado no catálogo. -/
def signVerdade (h : HarappaSign) : Prop := MveiTeoria.atestado h.index
/-- Um conceito é verdadeiro quando o sinal do mesmo número está atestado. -/
def conceitoVerdade (m : ModernConcept) : Prop := MveiTeoria.atestado m.id
instance : CoeSort HarappaSign Prop := ⟨signVerdade⟩
instance : CoeSort ModernConcept Prop := ⟨conceitoVerdade⟩

-- encodes / related / represents são usados com vários tipos
/-- Codificação: na camada abstrata é um único `codificaRel α` opaco; aqui cada tipo tem o critério dos seus dados. -/
class Codifica (α : Type) where
  rel : HarappaSign → α → Prop
def codificaRel (α : Type) [Codifica α] : HarappaSign → α → Prop := Codifica.rel
/-- O sinal N codifica o conceito N (o pareamento das 600 provas `precedence_N`). -/
instance : Codifica ModernConcept := ⟨fun h m => h.index = m.id⟩
/-- Um conceito matemático é codificado quando está no repertório do catálogo (os 417 equivalentes modernos). -/
instance : Codifica MathConcept := ⟨fun _ c => c.nome ∈ MveiTeoria.repertorio⟩
/-- Um teorema moderno é codificado pelos sinais que o marco da TIMELINE cita. -/
instance : Codifica ModernTheorem := ⟨fun s m => s.index ∈ m.marco.sinais⟩
def encodes {α : Type} [Codifica α] (h : HarappaSign) (m : α) : Prop := codificaRel α h m
/-- Relação entre elementos do mesmo tipo (um único `relatedRel α` opaco na camada abstrata). -/
class Relaciona (α : Type) where
  rel : α → α → Prop
def relatedRel (α : Type) [Relaciona α] : α → α → Prop := Relaciona.rel
/-- Dois sinais são relacionados quando são da mesma classe gramatical. -/
instance : Relaciona HarappaSign := ⟨fun a b => MveiTeoria.classe a.index = MveiTeoria.classe b.index⟩
/-- Dois conceitos, quando os sinais do mesmo número são da mesma classe gramatical. -/
instance : Relaciona ModernConcept := ⟨fun a b => MveiTeoria.classe a.id = MveiTeoria.classe b.id⟩
def related {α : Type} [Relaciona α] (a b : α) : Prop := relatedRel α a b
class Representa (α β : Type) (γ : outParam Type) where
  represents : α → β → γ
export Representa (represents)
/-- O sinal que representa um teorema moderno: o primeiro que o marco cita. -/
def repr2 (h : HarappaSign) (m : ModernTheorem) : Prop := h = MveiTeoria.sinal (m.marco.sinais.headD 0)
def repr3 (e : Encoding) (h : HarappaSign) (m : ModernConcept) : Prop := e.sinal = h.index ∧ e.conceito = m.id
instance : Representa HarappaSign ModernTheorem Prop := ⟨repr2⟩
instance : Representa Encoding HarappaSign (ModernConcept → Prop) := ⟨repr3⟩
/-- Precedência temporal (um único `precedeRel α β` opaco na camada abstrata). -/
class Precede (α : Sort u) (β : Sort v) where
  rel : α → β → Prop
def precedeRel (α : Sort u) (β : Sort v) [Precede α β] : α → β → Prop := Precede.rel
/-- Sinal antes de conceito: comparação das datas. -/
instance : Precede HarappaSign ModernConcept := ⟨fun h m => h.date < m.date⟩
/-- Conhecimento antes de qualquer coisa: a data do conhecimento é anterior ao início da era moderna do corpus
    (1600; o segundo argumento de `phase_zero_precedence` é de tipo arbitrário). -/
instance {β : Sort v} : Precede Knowledge β := ⟨fun k _ => k.date < 1600⟩
def temporal_precedence {α : Sort u} {β : Sort v} [Precede α β] (a : α) (b : β) : Prop := precedeRel α β a b

-- consistency_N
/-- Compatíveis: os dois sinais caem no período harappiano (−2600 … −1900). -/
def compat (s1 s2 : HarappaSign) : Prop :=
  (-2600 ≤ s1.date ∧ s1.date ≤ -1900) ∧ (-2600 ≤ s2.date ∧ s2.date ≤ -1900)

theorem mvei_periodo (s : HarappaSign) : -2600 ≤ s.date ∧ s.date ≤ -1900 := by
  have := Nat.min_le_right s.index 600
  show -2600 ≤ -2600 + ((min s.index 600 : Nat) : Int) ∧ -2600 + ((min s.index 600 : Nat) : Int) ≤ -1900
  omega

theorem mvei_teto (s : HarappaSign) : s.date ≤ -2000 := by
  have := Nat.min_le_right s.index 600
  show -2600 + ((min s.index 600 : Nat) : Int) ≤ -2000
  omega
def compatible (s1 s2 : HarappaSign) : Prop := compat s1 s2
/-- O corpus escolhe pares de ids arbitrários e usa as hipóteses de id só como argumentos: a lei que ele assume é que
    quaisquer dois sinais são compatíveis. -/
theorem compatibility_axiom : ∀ {s1 s2 : HarappaSign} {a b : Nat}, s1.id = a → s2.id = b → compat s1 s2 := by
  intro s1 s2 _ _ _ _
  exact ⟨mvei_periodo s1, mvei_periodo s2⟩

-- completeness_N, _strong, _equivalence
/-- Moderno: símbolo introduzido depois de 1600 (MveiTeoria.simbolosModernos, com tolerância). -/
def modern_concept (c : MathConcept) : Prop := c.nome ∈ MveiTeoria.simbolosModernos.map (·.nome)
theorem encoding_theorem : ∀ {s : HarappaSign} {c : MathConcept}, modern_concept c → encodes s c := by
  intro s c hc
  exact MveiTeoria.modernos_no_repertorio c.nome hc
/-- Exprimível: equivalente ao valor de uma fórmula da língua dos sinais na valoração canônica. -/
def expressible (p : Prop) : Prop :=
  ∃ φ : MveiTeoria.FormulaH, (p ↔ MveiTeoria.evalH MveiTeoria.valoracaoCanonica .harappa φ = true)
def encodes_list (signs : List HarappaSign) (p : Prop) : Prop :=
  ∃ φ : MveiTeoria.FormulaH, signs = φ.sinais.map MveiTeoria.sinal ∧
    (p ↔ MveiTeoria.evalH MveiTeoria.valoracaoCanonica .harappa φ = true)
theorem list_encoding : ∀ {p : Prop}, expressible p → ∃ signs : List HarappaSign, encodes_list signs p := by
  intro p ⟨φ, hφ⟩
  exact ⟨φ.sinais.map MveiTeoria.sinal, φ, rfl, hφ⟩
def traduzHM (_ : HarappaLogic) (_ : ModernLogic) (e : HarappaExpr) : Prop :=
  ∃ e' : MveiTeoria.FormulaM, MveiTeoria.tau e = e' ∧ ∀ v w, MveiTeoria.evalM v w e' = MveiTeoria.evalH v w e
def traduzMH (_ : HarappaLogic) (_ : ModernLogic) (e : ModernExpr) : Prop :=
  ∃ e' : MveiTeoria.FormulaH, MveiTeoria.tau e' = e ∧ ∀ v w, MveiTeoria.evalH v w e' = MveiTeoria.evalM v w e
abbrev equivalent_expressive_power (h : HarappaLogic) (m : ModernLogic) : Prop :=
  (∀ e : HarappaExpr, traduzHM h m e) ∧ (∀ e : ModernExpr, traduzMH h m e)
theorem h_to_m_translation : ∀ {h : HarappaLogic} {m : ModernLogic} {e : HarappaExpr}, traduzHM h m e := by
  intro _ _ e
  exact ⟨MveiTeoria.tau e, rfl, fun v w => MveiTeoria.evalM_tau v w e⟩
theorem m_to_h_translation : ∀ {h : HarappaLogic} {m : ModernLogic} {e : ModernExpr}, traduzMH h m e := by
  intro _ _ e
  refine ⟨MveiTeoria.sigma e, MveiTeoria.tau_sigma e, fun v w => ?_⟩
  rw [← MveiTeoria.evalM_tau, MveiTeoria.tau_sigma]

-- correspondence_N_*
/-- Forma justa do que `correspondence_N_bijective` pede. O par do gerador (`representation_exists`: todo sinal
    representa m; `representation_unique`) só tem modelo com `ModernTheorem` vazio, porque o catálogo tem sinais
    distintos (`Indeterminado.Refutacoes.representacao_classica_inconsistente`); este tem modelo com
    `represents h m := h = f m` para qualquer `f`. -/
theorem representation_bijective : ∀ (m : ModernTheorem), ∃! (h : HarappaSign), represents h m := by
  intro m
  exact ⟨_, rfl, fun _ hy => hy⟩
theorem structure_preservation : ∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
  encodes h1 m1 → encodes h2 m2 → related h1 h2 → related m1 m2 := by
  intro h1 h2 m1 m2 e1 e2 r
  have e1' : h1.index = m1.id := e1
  have e2' : h2.index = m2.id := e2
  have r' : MveiTeoria.classe h1.index = MveiTeoria.classe h2.index := r
  show MveiTeoria.classe m1.id = MveiTeoria.classe m2.id
  rw [← e1', ← e2']
  exact r'

-- meta_N_* (definições-padrão; Formula = Prop porque o enunciado escreve `¬formula`)
def derivable (s : LogicalSystem) (f : Formula) : Prop := (∀ a ∈ s, a) → f
def derives (s : LogicalSystem) : Prop := ∀ a ∈ s, a
def valid (f : Formula) : Prop := f
abbrev sound (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → valid formula
abbrev complete (s : LogicalSystem) : Prop := ∀ (formula : Formula), valid formula → derivable s formula
abbrev consistent (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → derivable s (¬formula) → False
-- `Decidable` é um tipo (classe de dados): "o sistema é decidível" como proposição é `Nonempty` da família de
-- decisões (a mesma leitura de reformulacoes/TeoriaMishkan e de SemanticaMishkan.decidabilidade_classica)
abbrev decidable_system (s : LogicalSystem) : Prop := Nonempty (∀ (formula : Formula), Decidable (derivable s formula))
theorem soundness_lemma : ∀ {s : LogicalSystem} {f : Formula}, derives s → derivable s f → valid f := by
  intro _ _ hs hd
  exact hd hs

-- verify_<P>_N e verify_<P>_N_encoding
/-- Problema do milênio: o ano real da formulação (MveiTeoria.problemas) e a prova de que é posterior a 1800
    (na camada abstrata a classe é vazia). -/
class ProblemaMilenio (α : Type) where
  ano : α → Int
  posterior : ∀ p, ano p > 1800
def discoveryDate (α : Type) [ProblemaMilenio α] : α → Int := ProblemaMilenio.ano
def discovery_date {α : Type} [ProblemaMilenio α] (p : α) : Int := discoveryDate α p
theorem modern_discovery : ∀ {α : Type} [ProblemaMilenio α] {p : α}, discovery_date p > 1800 := by
  intro _ _ p
  exact ProblemaMilenio.posterior p
/-- `verify_<P>_N` aplica a lei a qualquer id: todo sinal é anterior a −1900 (compatível com `harappa_period`). -/
theorem harappa_period_upper : ∀ {h : HarappaSign} {k : Nat}, h.id = k → h.date < -1900 := by
  intro h _ _
  have := mvei_teto h
  omega
class CodificaAspecto (α : Type) where
  rel : HarappaSign → α → Prop
def codificaAspecto (α : Type) [CodificaAspecto α] : HarappaSign → α → Prop := CodificaAspecto.rel
def encodes_aspect {α : Type} [CodificaAspecto α] (h : HarappaSign) (a : α) : Prop := codificaAspecto α h a
/-- O problema PNP. -/
structure PNPProblem
instance : ProblemaMilenio PNPProblem := ⟨fun _ => 1971, fun _ => show (1971 : Int) > 1800 by decide⟩
/-- Um sinal codifica o problema quando é anterior à formulação dele. -/
instance : Codifica PNPProblem := ⟨fun h p => h.date < discoveryDate PNPProblem p⟩
/-- Os 100 aspectos de PNP que o corpus enumera. -/
structure PNPAspect where
  id : Nat
  valido : 1 ≤ id ∧ id ≤ 100

instance : CodificaAspecto PNPAspect := ⟨fun h _ => h.date < 1971⟩
/-- `correspondence_N_PNP` usa o id só como argumento: todo sinal codifica todo problema. -/
theorem pnp_encoding : ∀ {h : HarappaSign} {m : PNPProblem} {k : Nat}, h.id = k → codificaRel PNPProblem h m := by
  intro h _ _ _
  show h.date < 1971
  have := mvei_teto h
  omega
theorem aspect_encoding_pnp : ∀ {h : HarappaSign} {a : PNPAspect} {k : Nat}, a.id = k → encodes_aspect h a := by
  intro h _ _ _
  show h.date < 1971
  have := mvei_teto h
  omega

