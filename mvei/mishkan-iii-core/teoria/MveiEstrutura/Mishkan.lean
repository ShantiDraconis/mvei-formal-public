-- integration_N_*
def equivalent (h : HarappaSystem) (m : ModernSystem) : Prop := h.v = m.v
def translate : HarappaSystem → ModernSystem → Translation :=
  fun h m => ⟨h, m⟩
def presF (t : Translation) (f : HarappaFormula) : Prop :=
  ∀ w, MveiTeoria.evalM t.destino.v w (MveiTeoria.tau f) = MveiTeoria.evalH t.origem.v w f
def preserves_semantics (t : Translation) : Prop := ∀ formula : HarappaFormula, presF t formula
theorem semantic_preservation : ∀ {h : HarappaSystem} {m : ModernSystem} {f : HarappaFormula},
  equivalent h m → presF (translate h m) f := by
  intro h m f he w
  show MveiTeoria.evalM m.v w (MveiTeoria.tau f) = MveiTeoria.evalH h.v w f
  rw [MveiTeoria.evalM_tau, show h.v = m.v from he]
def translation_function (f : HarappaFormula → ModernFormula) : Prop := f = MveiTeoria.tau
abbrev bijective (f : HarappaFormula → ModernFormula) : Prop := Function.Injective f ∧ Function.Surjective f
theorem injective_translation : ∀ {f : HarappaFormula → ModernFormula}, translation_function f → Function.Injective f := by
  intro f hf
  rw [show f = MveiTeoria.tau from hf]
  exact MveiTeoria.tau_injective
theorem surjective_translation : ∀ {f : HarappaFormula → ModernFormula}, translation_function f → Function.Surjective f := by
  intro f hf
  rw [show f = MveiTeoria.tau from hf]
  exact MveiTeoria.tau_surjective
/-- Isomorfas: iguais a menos de uma renomeação bijetiva dos átomos. -/
def isomorphic (h : HarappaStructure) (m : ModernStructure) : Prop :=
  ∃ s s' : Nat → Nat, (∀ n, s' (s n) = n) ∧ (∀ n, s (s' n) = n) ∧ ∀ w n, h.v w n = m.v w (s n)
def equivalent_theories (h : HarappaStructure) (m : ModernStructure) : Prop :=
  ∃ s : Nat → Nat, ∀ w (φ : MveiTeoria.FormulaH),
    MveiTeoria.evalH h.v w φ = MveiTeoria.evalM m.v w (MveiTeoria.renomear s (MveiTeoria.tau φ))
theorem theory_equivalence : ∀ {h : HarappaStructure} {m : ModernStructure}, isomorphic h m → equivalent_theories h m := by
  intro h m ⟨s, _, _, _, hv⟩
  exact ⟨s, fun w φ => MveiTeoria.equiv_renomear h.v m.v s hv w φ⟩

-- teoremas finais
def canonical_encoding : HarappaSign → ModernConcept → Encoding :=
  fun h m => ⟨h.index, m.id⟩
theorem representation_theorem : ∀ {h : HarappaSign} {m : ModernConcept}, represents (canonical_encoding h m) h m := by
  intro h m
  exact ⟨rfl, rfl⟩
theorem precedence_theorem : ∀ {h : HarappaSign} {m : ModernConcept}, temporal_precedence h m := by
  intro h m
  show h.date < MveiTeoria.geradorModerno m.id
  have := mvei_teto h
  unfold MveiTeoria.geradorModerno
  omega
/-- Equivalência lógica entre um sinal e um conceito: ambos bivalentes. -/
def logical_equivalence (h : HarappaSign) (m : ModernConcept) : Prop :=
  (signVerdade h ∨ ¬ signVerdade h) ∧ (conceitoVerdade m ∨ ¬ conceitoVerdade m)
theorem equivalence_theorem : ∀ {h : HarappaSign} {m : ModernConcept}, logical_equivalence h m := by
  intro h m
  exact ⟨Classical.em _, Classical.em _⟩
def expressible_in_modern (c : MathematicalConcept) : Prop := c.nome ∈ MveiTeoria.simbolosModernos.map (·.nome)
def expressible_in_harappa (c : MathematicalConcept) : Prop := c.nome ∈ MveiTeoria.repertorio
theorem backward_translation : ∀ {c : MathematicalConcept}, expressible_in_modern c → expressible_in_harappa c := by
  intro c hc
  exact MveiTeoria.modernos_no_repertorio c.nome hc
def valid_in_harappa (d : Derivation) : Prop := ∀ v w, MveiTeoria.evalH v w d = true
def valid_in_modern (d : Derivation) : Prop := ∀ v w, MveiTeoria.evalM v w (MveiTeoria.tau d) = true
theorem forward_translation : ∀ {d : Derivation}, valid_in_harappa d → valid_in_modern d := by
  intro d hd v w
  rw [MveiTeoria.evalM_tau]
  exact hd v w
theorem harappa_upper_bound : ∀ (s : HarappaSign), s.date < -1900 := by
  intro h
  have := mvei_teto h
  omega
theorem modern_lower_bound : ∀ (m : ModernTheorem), m.date > 1600 := by
  intro m
  exact MveiTeoria.teoremasModernos_datas _ (MveiTeoria.teorema_mem m.idx)
theorem implication_preservation : ∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
  encodes h1 m1 → encodes h2 m2 → (h1 → h2) → (m1 → m2) := by
  intro h1 h2 m1 m2 e1 e2 himp hm1
  have e1' : h1.index = m1.id := e1
  have e2' : h2.index = m2.id := e2
  have hm1' : MveiTeoria.atestado m1.id := hm1
  show MveiTeoria.atestado m2.id
  rw [← e2']
  exact himp (show MveiTeoria.atestado h1.index by rw [e1']; exact hm1')
theorem reverse_implication : ∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
  encodes h1 m1 → encodes h2 m2 → (m1 → m2) → (h1 → h2) := by
  intro h1 h2 m1 m2 e1 e2 mimp hh1
  have e1' : h1.index = m1.id := e1
  have e2' : h2.index = m2.id := e2
  have hh1' : MveiTeoria.atestado h1.index := hh1
  show MveiTeoria.atestado h2.index
  rw [e2']
  exact mimp (show MveiTeoria.atestado m1.id by rw [← e1']; exact hh1')
/-- Fase zero: conhecimento carregado por um sinal atestado. -/
def phase_zero (k : Knowledge) : Prop := MveiTeoria.atestado k.sinal
def logical_validity (k : Knowledge) : Prop := 0 < (MveiTeoria.sinal k.sinal).logical_interpretation.length
def archaeological_verification (k : Knowledge) : Prop :=
  0 < (MveiTeoria.sinal k.sinal).frequency ∧ 0 < (MveiTeoria.sinal k.sinal).archaeological_sites.length
theorem phase_zero_precedence : ∀ {k : Knowledge} {β : Sort v} {b : β}, phase_zero k → temporal_precedence k b := by
  intro k _ _ _
  have := Nat.min_le_right k.sinal 600
  show -2600 + ((min k.sinal 600 : Nat) : Int) < 1600
  omega
theorem phase_zero_logic : ∀ {k : Knowledge}, phase_zero k → logical_validity k := by
  intro k hk
  exact MveiTeoria.interpretacoes_nao_vazias k.sinal (Nat.lt_succ_of_le hk.2) hk.1
theorem phase_zero_archaeology : ∀ {k : Knowledge}, phase_zero k → archaeological_verification k := by
  intro k hk
  exact MveiTeoria.sinais_verificados k.sinal (Nat.lt_succ_of_le hk.2) hk.1

