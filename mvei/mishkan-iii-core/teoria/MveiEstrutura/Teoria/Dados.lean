/-
  Dados.lean — reformulacoes/TeoriaMishkan (MVEI; NÃO é do autor). Gerado por tools/teoria_mishkan.py.

  As tabelas do corpus, lidas dos arquivos do autor, e os GERADORES que as produzem (cada tabela é conferida
  no kernel contra a fórmula). Valores reais de referência com tolerância onde o corpus fala do mundo
  (marcos históricos, problemas do milênio, símbolos); onde o dado não existe, o valor construído pelo
  gerador fica marcado como extrapolação.
-/
import MveiEstrutura.Teoria.Aritmetica

set_option autoImplicit false

namespace MveiTeoria
open HarappaCatalog

/-- Os 417 sinais têm interpretação lógica não vazia … -/
theorem interpretacoes_nao_vazias : ∀ n < 418, 1 ≤ n → 0 < (sinal n).logical_interpretation.length := by decide +kernel

/-- … frequência positiva e pelo menos um sítio arqueológico. -/
theorem sinais_verificados : ∀ n < 418, 1 ≤ n →
    0 < (sinal n).frequency ∧ 0 < (sinal n).archaeological_sites.length := by decide +kernel

