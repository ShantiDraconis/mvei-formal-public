/-- Moderno, pelo critério do próprio autor (data > 1600), mesmo no limite inferior da tolerância. -/
def simbolosModernos : List SimboloDatado := simbolosDatados.filter (fun s => decide (s.ano - (s.tolerancia : Int) > 1600))

/-- Só o `=` (sinal 17, Recorde 1557) não é moderno por esse critério. -/
theorem so_o_igual_nao_eh_moderno : simbolosDatados.filter (fun s => !decide (s.ano - (s.tolerancia : Int) > 1600)) =
    simbolosDatados.filter (fun s => s.sinal == 17) := by decide +kernel

theorem simbolos_conferem : ∀ s ∈ simbolosDatados,
    (sinal s.sinal).modern_equivalent = s.nome ∧ 1 ≤ s.sinal ∧ s.sinal ≤ 417 := by decide +kernel

/-- Todo símbolo moderno datado está no repertório do catálogo. -/
theorem modernos_no_repertorio (x : String) (hx : x ∈ simbolosModernos.map (·.nome)) : x ∈ repertorio := by
  obtain ⟨s, hs, rfl⟩ := List.mem_map.1 hx
  have hs' : s ∈ simbolosDatados := (List.mem_filter.1 hs).1
  obtain ⟨h1, h2, h3⟩ := simbolos_conferem s hs'
  exact List.mem_map.2 ⟨sinal s.sinal, sinal_mem _ ⟨h2, h3⟩, h1⟩

