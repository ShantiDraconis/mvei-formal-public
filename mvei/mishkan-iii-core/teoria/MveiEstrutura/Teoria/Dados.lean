  ⟨"YangMills", 1954, 0, "Yang e Mills 1954"⟩,
  ⟨"NavierStokes", 1845, 23, "Navier 1822, Stokes 1845"⟩,
  ⟨"BSD", 1965, 5, "Birch e Swinnerton-Dyer, 1960-1965"⟩,
  ⟨"Poincare", 1904, 4, "Poincaré 1900-1904"⟩]

/-- Mesmo no limite inferior da tolerância, todos os sete foram formulados depois de 1800. -/
theorem problemas_modernos : ∀ p ∈ problemas, p.ano - (p.tolerancia : Int) > 1800 := by decide +kernel

/-! ## Símbolos dos operadores: data de introdução, com tolerância -/

structure SimboloDatado where
  sinal : Nat
  nome : String
  ano : Int
  tolerancia : Nat
  fonte : String
  deriving DecidableEq

/-- Os 27 sinais-operadores com a data em que o símbolo moderno foi introduzido (MacTutor, J. Miller, "Earliest
    Uses of Symbols…"; "estimativa" = valor aproximado do MVEI, tolerância larga). -/
