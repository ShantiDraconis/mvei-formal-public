def sitiosEvidencia : List String := ["Harappa", "Dholavira", "Lothal", "Kalibangan", "Mohenjo-daro"]

/-- O gerador da evidência N. -/
def gerEvidencia (n : Nat) : Evidencia :=
  ⟨sitiosEvidencia.getD ((n - 1) % 5) "", n % 12 + 1, -2600 + n, 20 + n % 30, -2595 + n, -2605 + n, 30 + 2 * n⟩

/-- As 600 evidências são exatamente o gerador. -/
theorem evidencias_geradas : ∀ n < 601, 1 ≤ n → evidencias.getD (n - 1) default = gerEvidencia n := by decide +kernel

/-- Com a incerteza de C14 do próprio gerador (20 + N mod 30 anos), o teto do período (−1900) vale para todo o
    intervalo de tolerância de cada um dos 600 sinais. -/
theorem teto_robusto : ∀ n : Nat, n ≤ 600 → dataSinal n + (20 + n % 30 : Nat) < -1900 := by
  intro n hn; unfold dataSinal; omega

/-- Já o piso (−2600, axioma `harappa_period` do autor) cai dentro da tolerância exatamente para os sinais 1 … 29. -/
theorem piso_na_tolerancia : ∀ n : Nat, 1 ≤ n → n ≤ 600 → (dataSinal n - (20 + n % 30 : Nat) < -2600 ↔ n ≤ 29) := by
  intro n h1 h2; unfold dataSinal; omega

/-- Termoluminescência e estratigrafia (±5 anos) concordam com o C14 dentro da incerteza, nas 600. -/
theorem metodos_concordam : ∀ e ∈ evidencias,
    (e.tl - e.c14).natAbs ≤ e.incerteza ∧ (e.estratigrafia - e.c14).natAbs ≤ e.incerteza := by decide +kernel

/-! ## Datas modernas (as 600 provas `precedence_N`: m.date = …) -/

/-- O gerador das 600 datas modernas: 1600 + (N mod 425). -/
def geradorModerno (n : Nat) : Int := 1600 + (n % 425 : Nat)

/-- A obstrução: o conceito 425 tem data 1600, que não é > 1600 (`modern_mathematics` do autor) … -/
theorem obstrucao_425 : geradorModerno 425 = 1600 := by decide

/-- … e é o único. Por isso a interpretação tem 599 conceitos modernos: com o 425, a lei de datação do gerador e o
    axioma do autor não valem juntos (reformulacoes/SemanticaMishkan, `precedence_0425_vazio`). -/
theorem so_o_425 : ∀ n : Nat, 1 ≤ n → n ≤ 600 → geradorModerno n ≤ 1600 → n = 425 := by
  intro n h1 h2 h3; unfold geradorModerno at h3; omega

