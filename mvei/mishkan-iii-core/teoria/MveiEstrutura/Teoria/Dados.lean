/-- Uma linhagem gerada por (início, passo) cobre todo ano: cada ano cai no mandato de algum guardião. -/
theorem cobertura (i : Int) (p : Nat) (hp : 0 < p) (y : Int) :
    ∃ k : Int, i + k * p ≤ y ∧ y < i + (k + 1) * p := by
  refine ⟨(y - i) / p, ?_, ?_⟩
  · have := Int.ediv_mul_le (y - i) (show (p : Int) ≠ 0 by omega)
    omega
  · have := Int.lt_ediv_add_one_mul_self (y - i) (show (0 : Int) < p by omega)
    rw [Int.add_mul, Int.one_mul] at this ⊢
    omega

