def materiais : List String := ["Cedro", "Cipreste", "Ouro", "Bronze", "Prata", "Acácia"]

def lugarDe (n : Nat) : String :=
  if n ≤ 100 then "Átrio Externo" else if n ≤ 150 then "Átrio das Mulheres" else if n ≤ 217 then "Átrio de Israel"
  else if n ≤ 317 then "Átrio dos Sacerdotes" else if n ≤ 377 then "Lugar Santo" else "Santo dos Santos"

/-- O gerador do pilar N: altura 10 + N mod 20 côvados, diâmetro 1 + (N mod 5)/2, posição (2,5·(N mod 30);
    2,5·(N div 30)), orientação 137,5·N mod 360 graus. -/
def gerPilar (n : Nat) : Pilar :=
  ⟨n, n, lugarDe n, materiais.getD ((n - 1) % 6) "", 100 * (10 + n % 20), 100 + 50 * (n % 5), 250 * (n % 30),
    250 * (n / 30), (13750 * n) % 36000⟩

theorem pilares_gerados : ∀ n < 418, 1 ≤ n → pilares.getD (n - 1) default = gerPilar n := by decide +kernel

theorem pilares_positivos : ∀ p ∈ pilares, 0 < p.altura ∧ 0 < p.diametro := by decide +kernel

theorem pilares_coerentes : ∀ p ∈ pilares, p.numero = p.sinal := by decide +kernel

theorem pilares_completos : ∀ n < 418, 1 ≤ n → ∃ p ∈ pilares, p.sinal = n := by
  intro n hn h1
  refine ⟨pilares.getD (n - 1) default, ?_, ?_⟩
  · have hl : pilares.length = 417 := by decide +kernel
    exact getD_mem _ _ _ (by omega)
  · rw [pilares_gerados n hn h1]; rfl

