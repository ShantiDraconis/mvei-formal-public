/-- O gerador: C14 da publicação k em −2580 + 5k. -/
theorem carbono_gerado : ∀ k < 71, carbonoMilenio.getD k 0 = -2580 + 5 * ((k + 1 : Nat) : Int) := by decide +kernel

/-- O gerador: publicação k no ano 1859 + 3·(k mod 50). -/
theorem publicacoes_geradas : ∀ k < 71, publicacoes.getD k 0 = 1859 + 3 * (((k + 1) % 50 : Nat) : Int) := by
  decide +kernel

theorem publicacoes_modernas : ∀ p ∈ publicacoes, p > 1800 := by decide +kernel

/-! ## LINEAGE_MAP: as duas comparações em Float (o kernel não avalia Float: `harappa_egypt_strong`,
    `lineage_is_complete`) -/

/-- Leitura decimal exata (centésimos): força 0,85 > 0,80 e completude 0,95 > 0,90. -/
theorem lineage_decimal : (85 : Nat) > 80 ∧ (95 : Nat) > 90 := by decide

/-- Leitura binary64 (o valor que o Float guarda): 0.85 = 7656119366529843/2⁵³, 0.8 = 3602879701896397/2⁵²,
    0.95 = 4278419646001971/2⁵², 0.90 = 8106479329266893/2⁵³. Nos valores guardados as duas comparações também
    valem … -/
theorem lineage_binary64 :
    7656119366529843 > 3602879701896397 * 2 ∧ 4278419646001971 * 2 > 8106479329266893 := by decide

/-- … e cada valor guardado difere do decimal por menos de 10⁻¹⁶ (tolerância do arredondamento). -/
theorem lineage_tolerancia :
    (7656119366529843 * 100 - 85 * 2 ^ 53 : Int).natAbs * 10 ^ 16 < 100 * 2 ^ 53 ∧
    (3602879701896397 * 100 - 80 * 2 ^ 52 : Int).natAbs * 10 ^ 16 < 100 * 2 ^ 52 ∧
    (4278419646001971 * 100 - 95 * 2 ^ 52 : Int).natAbs * 10 ^ 16 < 100 * 2 ^ 52 ∧
    (8106479329266893 * 100 - 90 * 2 ^ 53 : Int).natAbs * 10 ^ 16 < 100 * 2 ^ 53 := by decide

