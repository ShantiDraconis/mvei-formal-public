/-
  ContraA.lean — reformulacoes/SemanticaMishkan (MVEI; NÃO é do autor). Gerado por tools/semantica_mishkan.py a partir do
  mesmo texto da camada de nomes de mishkan-iii-core (core/MveiEstrutura/Mishkan.lean).

  Contramodelo A: as leis que dizem que tudo vale (todo sinal codifica, toda data cai no intervalo, todo par é compatível…) ficam falsas: tipos com um elemento, predicados falsos, datas 0; as `forward_N_M` falham com os sinais verdadeiros e os conceitos falsos.
  Cada `falha_X : ¬ (…)` tem o enunciado da lei X copiado da camada; o kernel confere que ela é falsa nesta interpretação.
-/
import SemanticaMishkan.Catalogo

set_option autoImplicit false
set_option maxRecDepth 4000


universe u v

/-! ## Ligações com o catálogo do autor -/

namespace HarappaCatalog.HarappaSign
/-- `id` dos arquivos gerados = `index` do catálogo. -/
def id (s : HarappaCatalog.HarappaSign) : Nat := s.index
/-- `number` (TEMPLE_ARCHITECTURE) = `index`. -/
def number (s : HarappaCatalog.HarappaSign) : Nat := s.index
/-- Data do sinal no contramodelo. -/
def date (_ : HarappaCatalog.HarappaSign) : Int := 0
end HarappaCatalog.HarappaSign

namespace MveiContraA.Mishkan

abbrev HarappaSign := HarappaCatalog.HarappaSign

instance : Inhabited HarappaSign := ⟨HarappaCatalog.sign_001⟩

/-- Lei de datação que as 600 provas `precedence_N` afirmam (h1 : h.date = −2600 + N), restrita ao intervalo em
    que o corpus a usa (N ≤ 600; acima disso valeria > −1900, contra `harappa_period` do próprio autor). -/
theorem falha_datacao_harappa : ¬ (∀ (h : HarappaSign) {n : Nat}, h.id = n → n ≤ 600 → h.date = -2600 + (n : Int)) := by intro H; exact absurd (H HarappaCatalog.sign_001 rfl (by decide)) (by decide)


