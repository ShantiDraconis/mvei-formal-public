def modern_concept : MathConcept → Prop := by intros; exact True
theorem falha_encoding_theorem : ¬ (∀ {s : HarappaSign} {c : MathConcept}, modern_concept c → encodes s c) := by intro H; exact H (s := HarappaCatalog.sign_001) (c := ()) trivial
def expressible : Prop → Prop := by intros; exact True
def encodes_list : List HarappaSign → Prop → Prop := by intros; exact False
theorem falha_list_encoding : ¬ (∀ {p : Prop}, expressible p → ∃ signs : List HarappaSign, encodes_list signs p) := by intro H; obtain ⟨_, h'⟩ := H (p := True) trivial; exact h'
def traduzHM : HarappaLogic → ModernLogic → HarappaExpr → Prop := by intros; exact False
def traduzMH : HarappaLogic → ModernLogic → ModernExpr → Prop := by intros; exact False
abbrev equivalent_expressive_power (h : HarappaLogic) (m : ModernLogic) : Prop :=
  (∀ e : HarappaExpr, traduzHM h m e) ∧ (∀ e : ModernExpr, traduzMH h m e)
theorem falha_h_to_m_translation : ¬ (∀ {h : HarappaLogic} {m : ModernLogic} {e : HarappaExpr}, traduzHM h m e) := by intro H; exact H (h := ()) (m := ()) (e := ())
theorem falha_m_to_h_translation : ¬ (∀ {h : HarappaLogic} {m : ModernLogic} {e : ModernExpr}, traduzMH h m e) := by intro H; exact H (h := ()) (m := ()) (e := ())

-- correspondence_N_*
/-- Forma justa do que `correspondence_N_bijective` pede. O par do gerador (`representation_exists`: todo sinal
    representa m; `representation_unique`) só tem modelo com `ModernTheorem` vazio, porque o catálogo tem sinais
    distintos (`Indeterminado.Refutacoes.representacao_classica_inconsistente`); este tem modelo com
    `represents h m := h = f m` para qualquer `f`. -/
theorem falha_representation_bijective : ¬ (∀ (m : ModernTheorem), ∃! (h : HarappaSign), represents h m) := by intro H; obtain ⟨_, h1, _⟩ := H (); exact h1

-- meta_N_* (definições-padrão; Formula = Prop porque o enunciado escreve `¬formula`)
def derivable : LogicalSystem → Formula → Prop := by intros; exact True
def derives : LogicalSystem → Prop := by intros; exact True
def valid : Formula → Prop := by intros; exact False
abbrev sound (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → valid formula
abbrev complete (s : LogicalSystem) : Prop := ∀ (formula : Formula), valid formula → derivable s formula
abbrev consistent (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → derivable s (¬formula) → False
def decidable_system : LogicalSystem → Prop := by intros; exact True
theorem falha_soundness_lemma : ¬ (∀ {s : LogicalSystem} {f : Formula}, derives s → derivable s f → valid f) := by intro H; exact H (s := ()) (f := True) trivial trivial

