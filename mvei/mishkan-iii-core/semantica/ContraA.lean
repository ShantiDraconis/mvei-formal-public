def precedeRel (α : Sort u) (β : Sort v) : α → β → Prop := by intros; exact False
def temporal_precedence {α : Sort u} {β : Sort v} (a : α) (b : β) : Prop := precedeRel α β a b

-- consistency_N
def compat : HarappaSign → HarappaSign → Prop := by intros; exact False
def compatible (s1 s2 : HarappaSign) : Prop := compat s1 s2
/-- O corpus escolhe pares de ids arbitrários e usa as hipóteses de id só como argumentos: a lei que ele assume é que
    quaisquer dois sinais são compatíveis. -/
theorem falha_compatibility_axiom : ¬ (∀ {s1 s2 : HarappaSign} {a b : Nat}, s1.id = a → s2.id = b → compat s1 s2) := by intro H; exact H (s1 := HarappaCatalog.sign_001) (s2 := HarappaCatalog.sign_001) rfl rfl

