-- verdade de um sinal / conceito (logical_preservation escreve `h1 → h2` com h1 : HarappaSign)
def signVerdade : HarappaSign → Prop := fun h => h.index = 1
def conceitoVerdade : ModernConcept → Prop := fun m => m = true
instance : CoeSort HarappaSign Prop := ⟨signVerdade⟩
instance : CoeSort ModernConcept Prop := ⟨conceitoVerdade⟩

-- encodes / related / represents são usados com vários tipos
def codificaRel (α : Type) : HarappaSign → α → Prop := by intros; exact True
def encodes {α : Type} (h : HarappaSign) (m : α) : Prop := codificaRel α h m
def relatedRel (α : Type) : α → α → Prop := fun a b => a = b
def related {α : Type} (a b : α) : Prop := relatedRel α a b
class Representa (α β : Type) (γ : outParam Type) where
  represents : α → β → γ
export Representa (represents)
def repr2 : HarappaSign → ModernTheorem → Prop := by intros; exact True
def repr3 : Encoding → HarappaSign → ModernConcept → Prop := by intros; exact False
instance : Representa HarappaSign ModernTheorem Prop := ⟨repr2⟩
instance : Representa Encoding HarappaSign (ModernConcept → Prop) := ⟨repr3⟩
def precedeRel (α : Sort u) (β : Sort v) : α → β → Prop := by intros; exact True
def temporal_precedence {α : Sort u} {β : Sort v} (a : α) (b : β) : Prop := precedeRel α β a b

-- consistency_N
def compat : HarappaSign → HarappaSign → Prop := by intros; exact True
def compatible (s1 s2 : HarappaSign) : Prop := compat s1 s2

-- completeness_N, _strong, _equivalence
def modern_concept : MathConcept → Prop := by intros; exact True
def expressible : Prop → Prop := by intros; exact True
def encodes_list : List HarappaSign → Prop → Prop := by intros; exact True
def traduzHM : HarappaLogic → ModernLogic → HarappaExpr → Prop := by intros; exact True
def traduzMH : HarappaLogic → ModernLogic → ModernExpr → Prop := by intros; exact True
abbrev equivalent_expressive_power (h : HarappaLogic) (m : ModernLogic) : Prop :=
  (∀ e : HarappaExpr, traduzHM h m e) ∧ (∀ e : ModernExpr, traduzMH h m e)

-- correspondence_N_*
theorem falha_structure_preservation : ¬ (∀ {h1 h2 : HarappaSign} {m1 m2 : ModernConcept},
  encodes h1 m1 → encodes h2 m2 → related h1 h2 → related m1 m2) := by intro H; have h1 : true = false := H (h1 := HarappaCatalog.sign_001) (h2 := HarappaCatalog.sign_001) (m1 := true) (m2 := false) trivial trivial rfl; exact Bool.noConfusion h1

-- meta_N_* (definições-padrão; Formula = Prop porque o enunciado escreve `¬formula`)
def derivable : LogicalSystem → Formula → Prop := by intros; exact True
def derives : LogicalSystem → Prop := by intros; exact True
def valid : Formula → Prop := by intros; exact True
abbrev sound (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → valid formula
abbrev complete (s : LogicalSystem) : Prop := ∀ (formula : Formula), valid formula → derivable s formula
abbrev consistent (s : LogicalSystem) : Prop := ∀ (formula : Formula), derivable s formula → derivable s (¬formula) → False
def decidable_system : LogicalSystem → Prop := by intros; exact True

