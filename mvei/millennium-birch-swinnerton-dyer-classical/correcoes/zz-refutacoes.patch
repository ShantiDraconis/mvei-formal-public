+import BSD.EllipticCurve.RegulatorHeightPairing
+
+/-! Refutações (MVEI): para cada teorema deste repositório cujo enunciado é falso como o Lean o lê, a
+    negação do enunciado, provada no kernel com as definições do próprio repositório. O teorema original
+    fica como está (o arquivo dele não muda). -/
+
+namespace MVEI.Refutacoes
+
+/-- `finitePointsBoundedHeight` (RegulatorHeightPairing) é falso: `EllipticCurvePoint ℚ` só exige
+`is_on_curve : True`, e todo ponto com `x = none` tem altura de Weil 0; os pontos ⟨none, some q, trivial⟩,
+q ∈ ℚ, são infinitos e têm altura 0 ≤ 0. -/
+theorem finitePointsBoundedHeight_falso :
+    ¬ (∀ C : ℝ, {P : EllipticCurvePoint ℚ | weilHeight P ≤ C}.Finite) := by
+  intro h
+  let f : ℚ → EllipticCurvePoint ℚ := fun q => ⟨none, some q, trivial⟩
+  have hinj : Function.Injective f := by
+    intro a b hab
+    have := congrArg EllipticCurvePoint.y hab
+    simpa [f] using this
+  have hsub : Set.range f ⊆ {P : EllipticCurvePoint ℚ | weilHeight P ≤ 0} := by
+    rintro _ ⟨q, rfl⟩
+    simp [f, weilHeight]
+  exact (Set.infinite_range_of_injective hinj).mono hsub (h 0)
+
+/-- `globalHeight_local_sum` é falso: neronTateHeight é o marcador 0 do autor, mas para o ponto com x = 2 a
+altura local arquimediana é log(max(|2|, 1)) = log 2 > 0 e as finitas são 0, então a soma é log 2 ≠ 0. -/
+theorem globalHeight_local_sum_falso :
+    ¬ (∀ P : EllipticCurvePoint ℚ, neronTateHeight P = ∑' v, localHeight v P) := by
+  intro h
+  let P : EllipticCurvePoint ℚ := ⟨some 2, none, trivial⟩
+  have hs : ∑' v, localHeight v P = Real.log 2 := by
+    rw [tsum_eq_single Place.infinite]
+    · simp [localHeight, P]
+    · intro v hv
+      cases v with
+      | infinite => exact absurd rfl hv
+      | finite p hp => simp [localHeight, P]
+  have h1 := h P
+  rw [hs] at h1
+  have : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
+  simp [neronTateHeight] at h1
+  linarith
+
+end MVEI.Refutacoes
