+/-- y² = x³ + x sobre ℚ: Δ = -64, c₄ = -48, j = 1728. -/
+def classicaJ1728 : EllipticCurveClassical ℚ where
+  coeffs := { a1 := 0, a2 := 0, a3 := 0, a4 := 1, a6 := 0 }
+  discriminant_ne_zero := by
+    simp only [WeierstrassCoefficientsClassical.discriminant, WeierstrassCoefficientsClassical.b2,
+      WeierstrassCoefficientsClassical.b4, WeierstrassCoefficientsClassical.b6, WeierstrassCoefficientsClassical.b8]
+    norm_num
+
+/-- y² = x³ + 1 sobre ℚ: Δ = -432, c₄ = 0, j = 0. -/
+def classicaJ0 : EllipticCurveClassical ℚ where
+  coeffs := { a1 := 0, a2 := 0, a3 := 0, a4 := 0, a6 := 1 }
+  discriminant_ne_zero := by
+    simp only [WeierstrassCoefficientsClassical.discriminant, WeierstrassCoefficientsClassical.b2,
+      WeierstrassCoefficientsClassical.b4, WeierstrassCoefficientsClassical.b6, WeierstrassCoefficientsClassical.b8]
