+/-- `EllipticCurveClassical.isomorphic_iff_same_j` é falso: o lado direito (`∃ u r s t, u ≠ 0 ∧ True`) vale
+sempre (u = 1), então o teorema diria que todas as curvas têm o mesmo j; mas j = 1728 para y² = x³ + x e
+j = 0 para y² = x³ + 1. -/
+theorem isomorphic_iff_same_j_falso :
+    ¬ (∀ (E₁ E₂ : EllipticCurveClassical ℚ), E₁.jInvariant = E₂.jInvariant ↔
+      ∃ (u : ℚ) (r s t : ℚ), u ≠ 0 ∧ True) := by
+  intro h
+  have h1 := (h classicaJ1728 classicaJ0).2 ⟨1, 0, 0, 0, one_ne_zero, trivial⟩
+  simp only [EllipticCurveClassical.jInvariant, EllipticCurveClassical.discriminant, classicaJ1728, classicaJ0,
+    WeierstrassCoefficientsClassical.discriminant, WeierstrassCoefficientsClassical.c4,
+    WeierstrassCoefficientsClassical.b2, WeierstrassCoefficientsClassical.b4, WeierstrassCoefficientsClassical.b6,
+    WeierstrassCoefficientsClassical.b8] at h1
+  norm_num at h1
+
+/-- `ShortWeierstrassClassical.j_1728_iff_B_zero` é falso: com a definição do autor
+`j = -1728·4A³/(4A³ + 27B²)`, a curva y² = x³ + x (A = 1, B = 0) tem B = 0 e j = -1728 ≠ 1728. -/
+theorem j_1728_iff_B_zero_falso :
+    ¬ (∀ (sw : ShortWeierstrassClassical ℚ) [NeZero (1728 : ℚ)], sw.jInvariant = 1728 ↔ sw.B = 0) := by
+  intro h
+  let sw : ShortWeierstrassClassical ℚ := ⟨1, 0, by norm_num⟩
+  have h1 := (@h sw ⟨by norm_num⟩).2 rfl
+  simp only [ShortWeierstrassClassical.jInvariant, sw] at h1
+  norm_num at h1
+
+/-- `regulator_well_defined` é falso: canonicalHeightClassical é o marcador 0 do autor, então a matriz de
+pareamento de qualquer lista não vazia é nula. Para a curva y² = x³ + x, a lista vazia tem regulador
+det(matriz 0×0) = 1 e a lista [O] tem regulador det((0)) = 0. -/
+theorem regulator_well_defined_falso :
+    ¬ (∀ (E : EllipticCurveClassical ℚ) (gens₁ gens₂ : List (CurvePointClassical E)), True →
+      regulatorClassical E gens₁ = regulatorClassical E gens₂) := by
+  intro h
+  have h1 := h classicaJ1728 [] [CurvePointClassical.infinity] trivial
+  simp [regulatorClassical, regulatorMatrixClassical, heightPairingClassical, canonicalHeightClassical,
+    Matrix.det_unique] at h1
+
+end MVEI.Refutacoes
