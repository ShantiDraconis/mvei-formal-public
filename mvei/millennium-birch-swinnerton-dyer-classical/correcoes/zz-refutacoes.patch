+    ¬ (∀ E : _root_.EllipticCurve ℚ, ∃ k : ℤ,
+      (discriminant' ℚ E.a1 E.a2 E.a3 E.a4 E.a6 : ℚ) = (Weierstrass.conductor E : ℚ) * k) := by
