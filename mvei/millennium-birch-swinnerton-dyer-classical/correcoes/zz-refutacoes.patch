+/-- A curva 11a1: y² + y = x³ - x² - 10x - 20 (Δ = -11⁵, c₄ = 496). -/
+def curva11a1 : EllipticCurveData where
+  a1 := 0
+  a2 := -1
+  a3 := 1
+  a4 := -10
+  a6 := -20
+  disc_ne_zero := by norm_num
+
+/-- `tamagawa_good` é falso: `badPrimes` é o marcador `∅` do autor, então a hipótese `p ∉ badPrimes E` vale para
+todo p; para 11a1 e p = 11, o algoritmo de Tate do autor vê v₁₁(Δ) = 5 ≠ 0 e v₁₁(c₄) = 0 (redução
+multiplicativa, split = true) e devolve c₁₁ = 5 ≠ 1. -/
+theorem tamagawa_good_falso :
+    ¬ (∀ (E : EllipticCurveData) (p : ℕ) [Fact (Nat.Prime p)], p ∉ badPrimes E → tamagawaAt E p = 1) := by
+  intro h
+  haveI : Fact (Nat.Prime 11) := ⟨by decide⟩
+  have h1 := h curva11a1 11 (by simp [badPrimes])
+  have hΔ : padicValNat 11 (TateInput.discriminant
+      ⟨11, Fact.out, 0, -1, 1, -10, -20⟩).natAbs = 5 := by
+    have : (TateInput.discriminant ⟨11, Fact.out, 0, -1, 1, -10, -20⟩).natAbs = 11 ^ 5 := by
+      simp only [TateInput.discriminant, TateInput.b2, TateInput.b4, TateInput.b6, TateInput.b8]
+      norm_num
+    rw [this, padicValNat.prime_pow]
+  have hc : padicValNat 11 (TateInput.c4 ⟨11, Fact.out, 0, -1, 1, -10, -20⟩).natAbs = 0 := by
+    apply padicValNat.eq_zero_of_not_dvd
+    simp only [TateInput.c4, TateInput.b2, TateInput.b4]
+    norm_num
+  simp only [tamagawaAt, tateAlgorithm, TateInput.discValuation, TateInput.c4Valuation, curva11a1] at h1
+  simp [hΔ, hc] at h1
+
+/-- Com a precedência corrigida (troca em enunciados.json), `tamagawa_product_factorization` sem a hipótese
+`v ∈ knownTamagawaData` é falso: o registro ⟨"", 2, []⟩ tem produto esperado 2 e produto vazio 1. -/
+theorem tamagawa_product_factorization_falso :
+    ¬ (∀ v : TamagawaVerification, v.expectedProduct = (v.localTamagawa.map (·.2)).foldl (· * ·) 1) := by
+  intro h
+  have := h ⟨"", 2, []⟩
+  simp at this
+
+end MVEI.Refutacoes
