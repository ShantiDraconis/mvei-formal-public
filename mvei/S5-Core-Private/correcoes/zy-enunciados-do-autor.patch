+/-! Definições de padrão posicional (antes omitidas como "stubs"), com os dados do corpus do autor:
+  harappan-00-universal, INDUS-KERNEL-CORE/analysis/position_stats.json (glifo G00x = sinal H00x, INDUS-KERNEL-CORE/glyphs/glyph_manifest.json; os 417 sinais H### seguem a numeração de Mahadevan 1977). -/
+
+/-- Contexto linguístico: a posição do sinal na inscrição (P1..P5 ↦ 0..4). -/
+abbrev Context := Fin 5
+
+/-- Ocorrências observadas de M-003 (G003/H003): 2, ambas em P3. -/
+def M003_occurrences : List Context := [2, 2]
+
+/-- Confiança alta: o padrão cobre todas as ocorrências, escolhe uma única posição, e a chance de todas as n
+    caírem numa mesma posição sob a uniforme, corrigida pela escolha da posição, 5·(1/5)ⁿ = (1/5)ⁿ⁻¹, fica abaixo de
+    5 % (5ⁿ⁻¹ > 20). -/
+def high_confidence (pattern : Context → Bool) (occ : List Context) : Prop :=
+  (occ.all pattern = true) ∧ (([0, 1, 2, 3, 4] : List Context).filter pattern).length = 1 ∧
+  5 ^ (occ.length - 1) > 20
+
+instance (pattern : Context → Bool) (occ : List Context) : Decidable (high_confidence pattern occ) := by
+  unfold high_confidence; exact inferInstance
+
+/-- A afirmação CLM-HAR-M003. -/
+abbrev CLM_HAR_M003 : Prop := ∃ pattern : Context → Bool, high_confidence pattern M003_occurrences
+
+/-- Decidida com os dados: com 2 ocorrências a chance corrigida é 1/5 = 20 % > 5 %; nenhum padrão tem confiança alta. -/
+theorem clm_har_m003_a : ¬ CLM_HAR_M003 := by
+  intro ⟨_, h⟩
+  exact absurd h.2.2 (by decide)
+
+/-- O ponto exato: com 3 ocorrências em P3 a chance é 1/25 = 4 % < 5 % e o padrão "posição 3" tem confiança alta. -/
+theorem clm_har_m003_amostra_minima : high_confidence (fun c => c == 2) [2, 2, 2] := by decide
 
 end S5.Core.Harappan
