+open Filter Topology in
+/-- Auxiliar: ∑ n! wⁿ não é somável para w ≠ 0 (teste da razão). -/
+theorem power_series_coeff_aux_fact (w : ℂ) (hw : w ≠ 0) :
+    ¬ Summable fun n : ℕ => (n.factorial : ℂ) * w ^ n := by
+  apply not_summable_of_ratio_norm_eventually_ge (r := 2) (by norm_num)
+  · refine Filter.Frequently.of_forall fun n => ?_
+    simp [Nat.factorial_ne_zero, hw]
+  · have hxa : 0 < ‖w‖ := norm_pos_iff.mpr hw
+    obtain ⟨N, hN⟩ := exists_nat_gt (2 / ‖w‖)
+    filter_upwards [Filter.eventually_ge_atTop N] with n hn
+    have h1 : (2 : ℝ) ≤ (n + 1) * ‖w‖ := by
+      have h3 : (N : ℝ) ≤ n := by exact_mod_cast hn
+      have h4 : 2 / ‖w‖ < n + 1 := by linarith
+      rw [div_lt_iff₀ hxa] at h4; linarith
+    have h2 : 0 ≤ (n.factorial : ℝ) * ‖w‖ ^ n := by positivity
+    have e1 : ‖(n.factorial : ℂ) * w ^ n‖ = (n.factorial : ℝ) * ‖w‖ ^ n := by
+      rw [norm_mul, norm_pow]; simp
+    have e2 : ‖((n + 1).factorial : ℂ) * w ^ (n + 1)‖ =
+        ((n + 1) * ‖w‖) * ((n.factorial : ℝ) * ‖w‖ ^ n) := by
+      rw [norm_mul, norm_pow, RCLike.norm_natCast, Nat.factorial_succ, pow_succ]; push_cast; ring
+    rw [e1, e2]
+    nlinarith
+
+open Filter Topology in
+/-- `ComplexDifferentiability.power_series_coeff` é falso como o Lean lê: `∑'` vale 0 numa série não somável. Com
+    f = 0, z₀ = 0 e aₙ = n! (a₀ = 0): para z ≠ 0 a série ∑ n! zⁿ diverge e o `tsum` vale 0 = f z; em z = 0 a soma é
+    a₀ = 0. Mas a₁ = 1 ≠ 0 = f'(0)/1!. -/
+theorem power_series_coeff_falso :
+    ¬ ∀ {f : ℂ → ℂ} {z₀ : ℂ} {a : ℕ → ℂ}, DifferentiableAt ℂ f z₀ →
+      (∀ᶠ z in 𝓝 z₀, f z = ∑' n, a n * (z - z₀) ^ n) →
+      ∀ n, a n = (iteratedDeriv n f z₀) / n.factorial := by
+  intro H
+  set a : ℕ → ℂ := fun n => if n = 0 then 0 else (n.factorial : ℂ) with ha
+  have hsum : ∀ z : ℂ, ∑' n, a n * (z - 0) ^ n = 0 := by
+    intro z
+    by_cases hz : z = 0
+    · subst hz
+      have : (fun n => a n * ((0 : ℂ) - 0) ^ n) = fun _ => 0 := by
+        funext n; rcases n with _ | n <;> simp [ha]
+      rw [this, tsum_zero]
+    · apply tsum_eq_zero_of_not_summable
+      intro hs
+      apply power_series_coeff_aux_fact z hz
+      have h1 := (summable_nat_add_iff 1).mpr hs
+      have h2 : Summable (fun n : ℕ => ((n + 1).factorial : ℂ) * z ^ (n + 1)) := by
+        simpa [ha] using h1
+      exact (summable_nat_add_iff 1).mp h2
+  have := H (f := fun _ => 0) (z₀ := 0) (a := a) (differentiableAt_const _)
+    (Eventually.of_forall fun z => (hsum z).symm) 1
+  simp [ha, iteratedDeriv_one] at this
+
