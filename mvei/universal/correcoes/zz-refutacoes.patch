+/-- Auxiliar: com f(w) = 0 em ‖w‖ < 1 e c fora, e φ contínua, φ ∘ (re, im) de f… não é contínua em (1, 0) quando
+    φ c ≠ φ 0: ao longo de (t, 0), t → 1⁻, vale φ 0, e em (1, 0) vale φ c. -/
+theorem harmonic_aux_not_cont (c : ℂ) (φ : ℂ → ℝ) (hφ : φ c ≠ φ 0) :
+    ¬ Continuous (fun p : ℝ × ℝ => φ ((fun w : ℂ => if ‖w‖ < 1 then 0 else c) (p.1 + p.2 * Complex.I))) := by
+  intro hc
+  have h1 : Tendsto (fun t : ℝ => φ ((fun w : ℂ => if ‖w‖ < 1 then 0 else c) ((t, (0 : ℝ)).1 + (t, (0 : ℝ)).2 * Complex.I)))
+      (𝓝[<] 1) (𝓝 (φ ((fun w : ℂ => if ‖w‖ < 1 then 0 else c) (((1 : ℝ), (0 : ℝ)).1 + ((1 : ℝ), (0 : ℝ)).2 * Complex.I)))) :=
+    ((hc.comp (continuous_id.prodMk continuous_const)).tendsto 1).mono_left nhdsWithin_le_nhds
+  have h2 : Tendsto (fun t : ℝ => φ ((fun w : ℂ => if ‖w‖ < 1 then 0 else c) ((t, (0 : ℝ)).1 + (t, (0 : ℝ)).2 * Complex.I)))
+      (𝓝[<] 1) (𝓝 (φ 0)) := by
+    refine tendsto_const_nhds.congr' ?_
+    filter_upwards [Ioo_mem_nhdsLT (show (0 : ℝ) < 1 by norm_num)] with t ht
+    have : ‖((t : ℂ) + (0 : ℝ) * Complex.I)‖ < 1 := by
+      simp only [Complex.ofReal_zero, zero_mul, add_zero, Complex.norm_real, Real.norm_eq_abs]
+      rw [abs_of_pos ht.1]; exact ht.2
+    simp only at this ⊢
+    rw [if_pos this]
+  have := tendsto_nhds_unique h1 h2
+  simp at this
+  exact hφ this
