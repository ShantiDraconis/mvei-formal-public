+/-- `StoneWeierstrassTheory.stone_weierstrass_lattice` é falso: a versão em reticulado do teorema pede separação
+    forte (valores prescritos em dois pontos), não só separar pontos e conter as constantes. Em X = Bool, o conjunto
+    A = {g | g false ≤ g true} é um sub-reticulado de C(Bool, ℝ), contém as constantes, separa os pontos (g = 1 em
+    true, 0 em false), é fechado e não é tudo (falta g = 0 em true, 1 em false), logo não é denso. -/
+theorem stone_weierstrass_lattice_falso :
+    ¬ ∀ {X : Type} [TopologicalSpace X] [CompactSpace X] [T2Space X] (A : Set C(X, ℝ)),
+      StoneWeierstrassTheory.IsSubLattice A → (∀ c : ℝ, (ContinuousMap.const X c) ∈ A) →
+      (∀ x y : X, x ≠ y → ∃ f ∈ A, f x ≠ f y) → Dense A := by
+  intro H
+  set A : Set C(Bool, ℝ) := {g | g false ≤ g true} with hA
+  have hcl : IsClosed A :=
+    isClosed_le (continuous_eval_const false) (continuous_eval_const true)
+  have hd := H A ⟨fun f hf g hg => by
+      simp only [hA, Set.mem_setOf_eq, ContinuousMap.sup_apply] at hf hg ⊢; exact sup_le_sup hf hg,
+    fun f hf g hg => by
+      simp only [hA, Set.mem_setOf_eq, ContinuousMap.inf_apply] at hf hg ⊢; exact inf_le_inf hf hg⟩
+    (fun c => show (ContinuousMap.const Bool c) false ≤ (ContinuousMap.const Bool c) true from le_rfl) (by
+      intro x y hxy
+      refine ⟨⟨fun b => if b then (1 : ℝ) else 0, continuous_of_discreteTopology⟩, ?_, ?_⟩
+      · show (if false then (1 : ℝ) else 0) ≤ (if true then (1 : ℝ) else 0)
+        norm_num
+      · cases x <;> cases y
+        · exact absurd rfl hxy
+        · show (if false then (1 : ℝ) else 0) ≠ (if true then (1 : ℝ) else 0)
+          norm_num
+        · show (if true then (1 : ℝ) else 0) ≠ (if false then (1 : ℝ) else 0)
+          norm_num
+        · exact absurd rfl hxy)
+  have huniv : A = Set.univ := by rw [← hcl.closure_eq, hd.closure_eq]
+  have hmem : (⟨fun b => if b then 0 else 1, continuous_of_discreteTopology⟩ : C(Bool, ℝ)) ∈ A := by
+    rw [huniv]; trivial
+  have h' : (if false then (0 : ℝ) else 1) ≤ (if true then (0 : ℝ) else 1) := hmem
+  norm_num at h'
+
+end MVEI.Refutacoes
