+    nas pontas, e `deriv f` é a derivada bilateral (0 quando não existe). Com f = -|·| e S = [-1, 0]: f = id em S
+    (convexa e derivável em S), deriv f (-1/2) = 1, mas deriv f 0 = 0, e -1/2 ≤ 0 com 1 > 0. -/
+theorem convex_deriv_mono_falso :
+    ¬ ∀ {f : ℝ → ℝ} {S : Set ℝ}, Convex ℝ S → ConvexOn ℝ S f → DifferentiableOn ℝ f S →
+      MonotoneOn (deriv f) S := by
+  intro h
+  have hEq : Set.EqOn (fun x : ℝ => x) (fun x : ℝ => -|x|) (Set.Icc (-1) 0) := by
+    intro x hx
+    simp only
+    rw [abs_of_nonpos hx.2, neg_neg]
+  have hconv : ConvexOn ℝ (Set.Icc (-1 : ℝ) 0) (fun x : ℝ => -|x|) :=
+    (convexOn_id (convex_Icc (-1 : ℝ) 0)).congr hEq
+  have hdiff : DifferentiableOn ℝ (fun x : ℝ => -|x|) (Set.Icc (-1 : ℝ) 0) :=
+    differentiableOn_id.congr fun x hx => (hEq hx).symm
