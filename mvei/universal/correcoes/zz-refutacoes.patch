+    by_cases h : ∃ n, f n = Set.univ
+    · obtain ⟨n, hn⟩ := h
+      left; exact Set.eq_univ_of_univ_subset (hn ▸ Set.subset_iUnion f n)
+    · push_neg at h
+      right
+      have : ∀ n, f n = {true} := fun n => (hf n).resolve_left (h n)
+      simp [this]
+  have hanti : ∀ f : ℕ → Set Bool, (∀ n, f n ∈ ℳ) → Antitone f → (⋂ n, f n) ∈ ℳ := by
+    intro f hf _
+    by_cases h : ∃ n, f n = {true}
+    · obtain ⟨n, hn⟩ := h
+      right
+      apply Set.Subset.antisymm
+      · exact hn ▸ Set.iInter_subset f n
+      · intro b hb
+        rw [Set.mem_singleton_iff.mp hb]
+        exact Set.mem_iInter.mpr fun m => htrue _ (hf m)
+    · push_neg at h
+      left
+      have : ∀ n, f n = Set.univ := fun n => (hf n).resolve_right (h n)
+      simp only [this, Set.iInter_const]
