+/-- `ComplexDifferentiability.holomorphic_imag_part_harmonic` é falso pelo mesmo motivo: Im f, com f = 0 na bola
+    unitária e 1 + i fora, não é contínua em (1, 0). -/
+theorem holomorphic_imag_part_harmonic_falso :
+    ¬ ∀ {f : ℂ → ℂ} {U : Set ℂ}, ComplexDifferentiability.Holomorphic f U → ContDiffOn ℂ 2 f U →
+      ∀ z ∈ U, ComplexDifferentiability.IsHarmonic (ComplexDifferentiability.imagPart f) := by
