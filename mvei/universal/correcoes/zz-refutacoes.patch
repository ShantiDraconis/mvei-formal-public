+theorem darboux_falso :
+    ¬ ∀ (f : ℝ → ℝ) (a b : ℝ), a < b → DifferentiableOn ℝ f (Set.Icc a b) → ∀ y : ℝ,
+      y ∈ Set.Ioo (deriv f a) (deriv f b) ∪ Set.Ioo (deriv f b) (deriv f a) →
+      ∃ c ∈ Set.Ioo a b, deriv f c = y := by
