+  have hhol : ComplexDifferentiability.Holomorphic f (Metric.ball 0 1) :=
+    ⟨Metric.isOpen_ball, fun y hy => (differentiableWithinAt_const (0 : ℂ)).congr
+      (fun w hw => hU w hw) (hU y hy)⟩
+  have hcd : ContDiffOn ℂ 2 f (Metric.ball 0 1) := contDiffOn_const.congr fun w hw => hU w hw
+  have h := H hhol hcd 0 (Metric.mem_ball_self one_pos)
+  exact harmonic_aux_not_cont (1 + Complex.I) Complex.re (by simp) h.1.continuous
