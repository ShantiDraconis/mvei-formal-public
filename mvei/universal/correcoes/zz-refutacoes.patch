+/-- `BaireCategoryTheory.dense_Gδ_not_meager` (sem `[Nonempty α]`) é falso no espaço vazio: lá ∅ é Gδ (interseção
+    de ∅), denso (não há pontos) e magro (coberto por ∅, que é raro), e `BaireSpace Empty` vale trivialmente. -/
+theorem dense_Gδ_not_meager_falso :
+    ¬ ∀ {α : Type} [TopologicalSpace α] [BaireSpace α] (S : Set α),
+      (∃ U : ℕ → Set α, (∀ n, IsOpen (U n)) ∧ S = ⋂ n, U n) → Dense S →
+      ¬BaireCategoryTheory.IsMeager' S := by
+  intro H
+  haveI : BaireSpace Empty := ⟨fun _ _ _ x => x.elim⟩
+  apply H (α := Empty) ∅ ⟨fun _ => ∅, fun _ => isOpen_empty, (Set.iInter_const (∅ : Set Empty)).symm⟩
+    (fun x => x.elim)
+  refine ⟨fun _ => ∅, fun _ => ?_, by simp⟩
+  simp [BaireCategoryTheory.IsNowhereDense']
+
+/-- `BaireCategoryTheory.baire_iff_not_meager` é falso: a volta (univ não magro ⇒ Baire) não vale. Em ℚ ⊔ {∗}
+    (soma topológica), o ponto ∗ é isolado, então univ não é magro (um raro não contém ponto isolado); mas os abertos
+    densos Uₙ = {inl qₙ}ᶜ (qₙ enumera ℚ) têm interseção {∗}, que não é densa. -/
+theorem baire_iff_not_meager_falso :
+    ¬ ∀ {α : Type} [TopologicalSpace α] [Nonempty α],
+      BaireCategoryTheory.IsBaireSpace' α ↔ ¬BaireCategoryTheory.IsMeager' (Set.univ : Set α) := by
+  intro H
+  have h := (H (α := ℚ ⊕ Unit)).mpr ?_
+  · obtain ⟨q, hq⟩ := exists_surjective_nat ℚ
+    set U : ℕ → Set (ℚ ⊕ Unit) := fun n => {Sum.inl (q n)}ᶜ with hU
+    have hUo : ∀ n, IsOpen (U n) ∧ Dense (U n) := by
+      intro n
+      refine ⟨isOpen_compl_singleton, ?_⟩
+      have hd : Dense ({q n}ᶜ : Set ℚ) := dense_compl_singleton (q n)
+      rw [dense_iff_closure_eq, Set.eq_univ_iff_forall]
+      intro z
+      rcases z with r | u
+      · have h1 : (Sum.inl r : ℚ ⊕ Unit) ∈ Sum.inl '' closure ({q n}ᶜ : Set ℚ) :=
+          ⟨r, by rw [hd.closure_eq]; trivial, rfl⟩
+        have h2 := image_closure_subset_closure_image continuous_inl h1
+        refine closure_mono ?_ h2
+        rintro _ ⟨s, hs, rfl⟩
+        simp only [hU, Set.mem_compl_iff, Set.mem_singleton_iff, Sum.inl.injEq]
+        exact hs
+      · apply subset_closure
+        simp [hU]
+    have hden := h U hUo
+    have hsub : (⋂ n, U n) ⊆ {Sum.inr ()} := by
+      intro z hz
+      rcases z with r | u
+      · obtain ⟨n, hn⟩ := hq r
+        have := Set.mem_iInter.mp hz n
+        simp [hU, hn] at this
+      · simp
+    have h0 : (Sum.inl 0 : ℚ ⊕ Unit) ∈ closure (⋂ n, U n) := by rw [hden.closure_eq]; trivial
+    have := closure_mono hsub h0
+    rw [closure_singleton] at this
+    simp at this
+  · rintro ⟨f, hf, hcov⟩
+    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp (hcov (Set.mem_univ (Sum.inr ())))
+    have hopen : IsOpen ({Sum.inr ()} : Set (ℚ ⊕ Unit)) := by
+      have := (isOpen_range_inr : IsOpen (Set.range (Sum.inr : Unit → ℚ ⊕ Unit)))
+      convert this using 1
+      ext z; rcases z with r | u <;> simp
+    have hsub : ({Sum.inr ()} : Set (ℚ ⊕ Unit)) ⊆ interior (closure (f n)) :=
+      interior_maximal (Set.singleton_subset_iff.mpr (subset_closure hn)) hopen
+    have hnd := hf n
+    unfold BaireCategoryTheory.IsNowhereDense' at hnd
+    rw [hnd] at hsub
+    exact hsub rfl
+
+end MVEI.Refutacoes
