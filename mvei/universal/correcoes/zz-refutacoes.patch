+/-- `SigmaAlgebras.monotone_class` é falso: o teorema da classe monótona pede que 𝒜 seja uma álgebra (fechada por
+    complemento), não só um π-sistema. Com Ω = Bool, 𝒜 = {{true}} e ℳ = {univ, {true}} (uma classe monótona com
+    univ, que contém 𝒜): {false} = {true}ᶜ está na σ-álgebra gerada, mas não em ℳ. -/
+theorem monotone_class_falso :
+    ¬ ∀ (Ω : Type) (𝒜 : Set (Set Ω)), (∀ A B, A ∈ 𝒜 → B ∈ 𝒜 → A ∩ B ∈ 𝒜) →
+      ∀ (ℳ : Set (Set Ω)), Set.univ ∈ ℳ →
+      (∀ f : ℕ → Set Ω, (∀ n, f n ∈ ℳ) → Monotone f → (⋃ n, f n) ∈ ℳ) →
+      (∀ f : ℕ → Set Ω, (∀ n, f n ∈ ℳ) → Antitone f → (⋂ n, f n) ∈ ℳ) →
+      𝒜 ⊆ ℳ → (SigmaAlgebras.generatedSigmaAlgebra Ω 𝒜).measurableSets ⊆ ℳ := by
+  intro H
+  set 𝒜 : Set (Set Bool) := {{true}} with h𝒜
+  set ℳ : Set (Set Bool) := {S | S = Set.univ ∨ S = {true}} with hℳ
+  have htrue : ∀ S ∈ ℳ, true ∈ S := by
+    rintro S (rfl | rfl) <;> simp
