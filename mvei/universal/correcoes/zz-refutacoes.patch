+      intro A B hA hB
+      rw [h𝒜, Set.mem_singleton_iff] at hA hB
+      subst hA; subst hB; simp [h𝒜]) ℳ (Or.inl rfl) hmono hanti
+    (by intro S hS; rw [h𝒜, Set.mem_singleton_iff] at hS; exact Or.inr hS)
+  have hgen : ({true} : Set Bool) ∈ (SigmaAlgebras.generatedSigmaAlgebra Bool 𝒜).measurableSets :=
+    SigmaAlgebras.generator_subset Bool 𝒜 (by simp [h𝒜])
+  have hc := (SigmaAlgebras.generatedSigmaAlgebra Bool 𝒜).compl_mem _ hgen
+  rcases hsub hc with h | h
+  · have : true ∈ ({true} : Set Bool)ᶜ := by rw [h]; trivial
+    simp at this
+  · have : false ∈ ({true} : Set Bool)ᶜ := by simp
+    rw [h] at this; simp at this
+
+end MVEI.Refutacoes
