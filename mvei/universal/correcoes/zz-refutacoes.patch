+    ¬ ∀ {f : ℂ → ℂ} {U : Set ℂ}, ComplexDifferentiability.Holomorphic f U → ContDiffOn ℂ 2 f U →
+      ∀ z ∈ U, ComplexDifferentiability.IsHarmonic (ComplexDifferentiability.realPart f) := by
