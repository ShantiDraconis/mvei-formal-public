+    ¬ ∀ {f : ℂ → ℂ} {U : Set ℂ}, IsOpen U → IsConnected U → ComplexDifferentiability.Holomorphic f U → f ≠ 0 →
+      ∀ z₀ ∈ U, f z₀ = 0 → ∃ r > 0, ∀ z ∈ Metric.ball z₀ r \ {z₀}, f z ≠ 0 := by
+  intro H
+  classical
+  let f : ℂ → ℂ := fun z => if z ∈ Metric.ball (0 : ℂ) 1 then 0 else 1
+  have hU : IsOpen (Metric.ball (0 : ℂ) 1) := Metric.isOpen_ball
+  have hc : IsConnected (Metric.ball (0 : ℂ) 1) := (convex_ball (0 : ℂ) 1).isConnected (by simp)
+  have hhol : ComplexDifferentiability.Holomorphic f (Metric.ball (0 : ℂ) 1) := by
+    refine ⟨hU, ?_⟩
+    have : Set.EqOn f (fun _ => 0) (Metric.ball (0 : ℂ) 1) := fun z hz => by
+      show (if z ∈ Metric.ball (0 : ℂ) 1 then (0 : ℂ) else 1) = 0
+      rw [if_pos hz]
+    exact (differentiableOn_const 0).congr this
+  have hne : f ≠ 0 := by
+    intro h
+    have := congrFun h 2
+    simp [f, Complex.dist_eq] at this
+  obtain ⟨r, hr, hz⟩ := H hU hc hhol hne 0 (Metric.mem_ball_self one_pos) (by simp [f])
+  set t : ℝ := min (r / 2) (1 / 2) with ht
+  have ht0 : 0 < t := lt_min (by linarith) (by norm_num)
+  have hmem : ((t : ℝ) : ℂ) ∈ Metric.ball (0 : ℂ) r \ {0} := by
+    refine ⟨?_, ?_⟩
+    · rw [Metric.mem_ball, Complex.dist_eq, sub_zero, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht0]
