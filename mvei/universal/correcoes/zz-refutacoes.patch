+    (differentiableOn_id.congr fun x hx => abs_of_nonneg hx.1) (1/2)
+    (Or.inl ⟨by rw [deriv_abs_zero]; norm_num, by rw [deriv_abs_pos one_pos]; norm_num⟩)
+  rw [deriv_abs_pos hc.1] at hdc
