+namespace MVEI.Refutacoes
+
+/-- `Connectedness.interval_connected` é falso: para a > b o intervalo `Icc a b` é vazio, e `IsConnected` exige
+    conjunto não vazio (com a = 1, b = 0). -/
+theorem interval_connected_falso : ¬ ∀ a b : ℝ, IsConnected (Set.Icc a b) := by
+  intro h
+  have := (h 1 0).nonempty
+  rw [Set.nonempty_Icc] at this
+  norm_num at this
+
+/-- `Connectedness.convex_path_connected` é falso: o conjunto vazio é convexo, e `IsPathConnected` exige um ponto
+    do conjunto (com E = ℝ e S = ∅). -/
+theorem convex_path_connected_falso :
+    ¬ ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] (S : Set E), Convex ℝ S → IsPathConnected S := by
+  intro h
+  obtain ⟨x, hx, -⟩ := h ℝ ∅ convex_empty
+  exact hx
+
+/-- `Connectedness.zero_dim_is_totally_disc` é falso: IsZeroDimensional (base de abertos-fechados em cada ponto) não
+    exige separação; em Bool com a topologia indiscreta a única vizinhança é univ, que é aberto-fechado, mas univ é
+    conexo com dois pontos. -/
+theorem zero_dim_is_totally_disc_falso :
+    ¬ ∀ {α : Type} [TopologicalSpace α], Connectedness.IsZeroDimensional α → TotallyDisconnectedSpace α := by
+  intro H
+  letI : TopologicalSpace Bool := ⊤
+  have hz : Connectedness.IsZeroDimensional Bool := by
+    intro x U hU
+    have hU' : U = Set.univ := Filter.mem_top.mp (by rwa [nhds_top] at hU)
+    exact ⟨Set.univ, hU' ▸ subset_rfl, Filter.univ_mem, isClopen_univ⟩
+  have ht := H hz
+  have hpre : IsPreconnected (Set.univ : Set Bool) := by
+    intro u v hu hv _ hsu hsv
+    have hu' : u = Set.univ := by
+      rcases (TopologicalSpace.isOpen_top_iff u).1 hu with h | h
+      · obtain ⟨y, -, hy⟩ := hsu; rw [h] at hy; exact absurd hy (Set.not_mem_empty y)
+      · exact h
+    obtain ⟨y, -, hy⟩ := hsv
+    exact ⟨y, trivial, by rw [hu']; trivial, hy⟩
+  have := ht.isTotallyDisconnected_univ Set.univ (Set.subset_univ _) hpre
+  exact absurd (this (Set.mem_univ true) (Set.mem_univ false)) (by decide)
+
+end MVEI.Refutacoes
