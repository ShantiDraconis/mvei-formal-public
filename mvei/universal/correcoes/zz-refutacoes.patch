+  intro hs
+  have hc : (Set.Ioo a b).Countable := hs.countable_support.mono (fun n hn => h n hn)
+  have h0 := hc.measure_zero MeasureTheory.volume
+  rw [Real.volume_Ioo, ENNReal.ofReal_eq_zero] at h0
+  linarith
