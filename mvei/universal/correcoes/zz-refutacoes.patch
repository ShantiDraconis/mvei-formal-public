+/-- `BaireCategoryTheory.residual_countable_inter` é falso sem a hipótese de espaço de Baire: em ℚ cada {q}ᶜ é aberto
+    e denso (residual), mas a interseção de {qₙ}ᶜ sobre uma enumeração de ℚ é vazia, e ∅ não é denso. -/
+theorem residual_countable_inter_falso :
+    ¬ ∀ {α : Type} [TopologicalSpace α] (S : ℕ → Set α), (∀ n, BaireCategoryTheory.IsResidual' (S n)) →
+      BaireCategoryTheory.IsResidual' (⋂ n, S n) := by
+  intro H
+  let q : ℕ → ℚ := fun n => (Denumerable.eqv ℚ).symm n
+  have hres : ∀ n, BaireCategoryTheory.IsResidual' ({q n}ᶜ : Set ℚ) := by
+    intro n
+    exact ⟨{q n}ᶜ, le_rfl, ⟨fun _ => {q n}ᶜ, fun _ => isOpen_compl_singleton, (Set.iInter_const _).symm⟩,
+      dense_compl_singleton (q n)⟩
+  obtain ⟨G, hG, -, hd⟩ := H (fun n => ({q n}ᶜ : Set ℚ)) hres
+  have hempty : (⋂ n, ({q n}ᶜ : Set ℚ)) = ∅ := by
+    ext x
+    simp only [Set.mem_iInter, Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_empty_iff_false, iff_false,
+      not_forall, not_not]
+    exact ⟨Denumerable.eqv ℚ x, ((Denumerable.eqv ℚ).symm_apply_apply x).symm⟩
+  rw [hempty, Set.subset_empty_iff] at hG
+  rw [hG] at hd
+  have h0 := hd.closure_eq
+  rw [closure_empty] at h0
+  exact (Set.empty_ne_univ h0)
+
+end MVEI.Refutacoes
